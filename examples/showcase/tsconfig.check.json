{
  "compilerOptions": {
    "target": "ES2020", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2020", "DOM"], "strict": true, "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true, "isolatedModules": true,
    "verbatimModuleSyntax": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["src"]
}
