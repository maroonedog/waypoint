{
  "name": "form-contract-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w form-contract && npm run build -w form-contract-resolver-zod && npm run build -w form-contract-resolver-luq && npm run build -w form-core && npm run build -w form-react && npm run build -w form-store-zustand",
    "test": "node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json && tsc -p test/types-unregistered/tsconfig.json && tsc -p test/types-source/tsconfig.json && tsc -p bench/tsconfig.json && tsc -p examples/nested-arrays/tsconfig.check.json && tsc -p examples/playground/tsconfig.check.json && tsc -p examples/showcase/tsconfig.check.json",
    "verify": "npm run build && npm run test && npm run test:types",
    "bench:forms": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run-forms-bench.ts",
    "bench:forms:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run-forms-bench.ts --check",
    "bench:forms:time": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run-time-bench.ts",
    "example:showcase": "vite --config examples/showcase/vite.config.ts examples/showcase",
    "example:nested-arrays": "vite --config examples/nested-arrays/vite.config.ts examples/nested-arrays",
    "example:playground": "vite --config examples/playground/vite.config.ts examples/playground",
    "docs:dev": "npm run dev --prefix docs-site",
    "docs:build": "npm ci --prefix docs-site && npm run build --prefix docs-site",
    "size": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run-size-bench.ts",
    "size:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning bench/run-size-bench.ts --check"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@maroonedog/luq": "^2.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "formik": "^2.4.9",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "zod": "^4.0.14",
    "zustand": "^5.0.9"
  }
}
