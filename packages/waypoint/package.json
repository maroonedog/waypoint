{
  "name": "@maroonedog/waypoint",
  "version": "0.1.0",
  "description": "A field's address exists before the component that draws it: typed paths the compiler has already checked and runtime state already written, with a contract any validator can describe itself through, resolvers and React and Vue bindings behind one install",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "maroonedog",
  "homepage": "https://github.com/maroonedog/waypoint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maroonedog/waypoint.git"
  },
  "bugs": {
    "url": "https://github.com/maroonedog/waypoint/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/contract/index.js",
  "types": "./dist/contract/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./resolver-standard": {
      "types": "./dist/resolver-standard/index.d.ts",
      "default": "./dist/resolver-standard/index.js"
    },
    "./resolver-zod": {
      "types": "./dist/resolver-zod/index.d.ts",
      "default": "./dist/resolver-zod/index.js"
    },
    "./resolver-luq": {
      "types": "./dist/resolver-luq/index.d.ts",
      "default": "./dist/resolver-luq/index.js"
    },
    "./store-zustand": {
      "types": "./dist/store-zustand/index.d.ts",
      "default": "./dist/store-zustand/index.js"
    },
    "./package.json": "./package.json",
    "./resolver-valibot": {
      "types": "./dist/resolver-valibot/index.d.ts",
      "default": "./dist/resolver-valibot/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "vue": [
        "dist/vue/index.d.ts"
      ],
      "resolver-standard": [
        "dist/resolver-standard/index.d.ts"
      ],
      "resolver-zod": [
        "dist/resolver-zod/index.d.ts"
      ],
      "resolver-luq": [
        "dist/resolver-luq/index.d.ts"
      ],
      "store-zustand": [
        "dist/store-zustand/index.d.ts"
      ],
      "resolver-valibot": [
        "dist/resolver-valibot/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "form",
    "forms",
    "react",
    "vue",
    "schema",
    "validation",
    "typescript",
    "zod",
    "standard-schema"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@maroonedog/luq": "^2.9.0",
    "react": ">=18",
    "vue": ">=3.5.0",
    "zod": "^4.2.0",
    "valibot": "^1.5.0",
    "@valibot/to-json-schema": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@maroonedog/luq": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "@valibot/to-json-schema": {
      "optional": true
    }
  }
}
