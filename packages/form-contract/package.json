{
  "name": "@maroonedog/form-contract",
  "version": "0.1.0",
  "description": "A contract that lets any validator describe itself as a form, with a runtime, React bindings and resolvers behind one install",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "maroonedog",
  "homepage": "https://github.com/maroonedog/form-contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maroonedog/form-contract.git"
  },
  "bugs": {
    "url": "https://github.com/maroonedog/form-contract/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/contract/index.js",
  "types": "./dist/contract/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./resolver-zod": {
      "types": "./dist/resolver-zod/index.d.ts",
      "default": "./dist/resolver-zod/index.js"
    },
    "./resolver-luq": {
      "types": "./dist/resolver-luq/index.d.ts",
      "default": "./dist/resolver-luq/index.js"
    },
    "./store-zustand": {
      "types": "./dist/store-zustand/index.d.ts",
      "default": "./dist/store-zustand/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core/index.d.ts"
      ],
      "react": [
        "dist/react/index.d.ts"
      ],
      "resolver-zod": [
        "dist/resolver-zod/index.d.ts"
      ],
      "resolver-luq": [
        "dist/resolver-luq/index.d.ts"
      ],
      "store-zustand": [
        "dist/store-zustand/index.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "form",
    "forms",
    "react",
    "schema",
    "validation",
    "typescript",
    "zod",
    "standard-schema"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
