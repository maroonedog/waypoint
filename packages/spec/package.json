{
  "name": "form-contract",
  "version": "0.1.0",
  "description": "A contract that lets any validator describe itself as a form, and a resolver path for the ones that cannot",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "keywords": ["form", "schema", "validation", "typescript", "standard-schema"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
