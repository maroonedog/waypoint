---
// ===========================================================================
// Base.astro — the frame every page is drawn in.
//
// TWO FRAMES, not one. A landing page and a reference page are read
// differently: one is scrolled once by somebody deciding, the other is
// returned to by somebody who already decided and needs one fact. So `/` is a
// single centred column, and every other page is a documentation shell — a
// section index on the left that is present on every page, the content in the
// middle, and on a wide screen the page's own headings on the right.
//
// The index is the change that matters. With ten pages and a wrapping top
// bar there was no view of the whole from anywhere in it: a reader on
// /validation/ could not see that /paths/ existed without going back up. That
// is what react-hook-form and Formik both spend their left margin on.
//
// The right rail is built from the DOM rather than passed in as a prop,
// because a hand-maintained list of a page's own headings is a list that goes
// stale the first time somebody renames one.
//
// It appears at 1400 rather than at xl, and the content column is capped at
// 54rem. Measured at xl: the third column took 68px off the text, so the
// window got wider and the reading column got narrower — which is the one
// thing a responsive layout must never do. By 1400 the cap is already reached,
// so the column does not move when the rail arrives.
// ===========================================================================
import "../styles.css";

interface Props {
  readonly title: string;
  readonly description: string;
  /** The landing page. Everything else gets the documentation shell. */
  readonly bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// TWO REGISTERS, AND THE LIST LIVES HERE RATHER THAN IN A PROP. A page that
// is returned to for one fact is set denser and heads its entries in the mono
// — see the register block in styles.css. Which pages those are is one fact
// about the site, and one fact belongs in one place: a prop would put it in
// ten files that can come to disagree with each other.
const FINDING = ["/api/", "/benchmark/"];

// Material Design 3 arrives on exactly one page, because exactly one page
// mounts the showcase. Roboto and the icon face are ITS typefaces: requested
// here they were downloaded by all ten pages and painted on one. Three files
// on nine pages, for nothing.
const MATERIAL = ["/showcase/"];

const register = FINDING.includes(Astro.url.pathname) ? "finding" : "reading";
const material = MATERIAL.includes(Astro.url.pathname);

// The docs faces, requested as one stylesheet. Source Serif 4 for what is
// argued, DM Mono for what is addressed — the rule is written down in
// styles.css because it decides every call site.
//
// 500 IS IN THE RANGE BECAUSE 68 ELEMENTS ASK FOR IT. Without it `font-medium`
// on a serif element resolved down to 400 and rendered as body text, so every
// emphasis written that way was silently not there.
const FACES =
  "https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&display=swap";
const MATERIAL_FACES =
  "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&family=Roboto:wght@400;500;700&display=swap";

// Grouped, because ten flat links is a list and three groups of three, three
// and four is a structure. The labels say what a reader wants, not what the
// pages are about.
const SECTIONS = [
  {
    group: "Getting started",
    items: [
      { href: "/", label: "Overview" },
      { href: "/showcase/", label: "Showcase" },
      { href: "/start/", label: "Start" },
    ],
  },
  {
    group: "How it behaves",
    items: [
      { href: "/validation/", label: "Validation" },
      { href: "/runtime/", label: "The runtime" },
      { href: "/paths/", label: "Typed paths" },
    ],
  },
  {
    group: "Reference",
    items: [
      { href: "/contract/", label: "The contract" },
      { href: "/api/", label: "API" },
      { href: "/examples/", label: "Examples" },
      { href: "/benchmark/", label: "Benchmark" },
    ],
  },
];

const here = Astro.url.pathname;
const flat = SECTIONS.flatMap((section) => section.items);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={FACES} rel="stylesheet" />
    {material && <link href={MATERIAL_FACES} rel="stylesheet" />}
  </head>

  <body class="bg-surface text-on-surface">
    <header
      class="sticky top-0 z-20 border-b border-outline-variant bg-surface/85 backdrop-blur"
    >
      <!-- THE HEADER'S CONTAINER IS THE PAGE'S CONTAINER. The two frames are
           different widths, and one container for both put the wordmark and
           the headline on different left edges: at 1600px the mark started at
           88px and the landing h1 at 312px, so nothing on the page lined up
           with the thing naming it. The chrome sits on the page it belongs
           to. -->
      <div
        class:list={[
          "mx-auto flex items-center gap-6 py-3",
          bare ? "max-w-5xl px-6" : "max-w-[92rem] px-4 sm:px-6",
        ]}
      >
        <!-- THE MARK IS DRAWN HERE RATHER THAN LINKED, and the difference is
             the theme: `favicon.svg` hard-codes two hexes, which is correct
             for a browser tab — a tab icon has no page to take its colours
             from — and wrong on a page that has two schemes. Inline, the
             stroke and the dot are `currentColor` and the tile is dropped:
             the rounded tile exists so the mark survives browser chrome, and
             on a page with its own ground it is a sticker.

             `aria-hidden` on purpose: the link already says "waypoint", and a
             second accessible name on one link is one more thing a screen
             reader reads out for no gain. -->
        <a
          href="/"
          class="flex shrink-0 items-center gap-2 font-mono text-sm font-medium text-on-surface"
        >
          <svg
            aria-hidden="true"
            width="17"
            height="17"
            viewBox="0 0 32 32"
            fill="none"
          >
            <path
              d="M16 4 28 16 16 28 4 16Z"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linejoin="round"></path>
            <circle cx="16" cy="16" r="3.2" fill="currentColor"></circle>
          </svg>waypoint
        </a>
        <!-- Below lg the index is not on the page, so the sections live here
             and wrap rather than scroll: a link you have to scroll to is a
             link nobody finds.

             ON THE LANDING PAGE THERE IS NO INDEX AT ANY WIDTH, so this is the
             only navigation the page has and it must not be hidden. Measured
             before this line: above 1024px `/` carried exactly one in-site
             link — the wordmark, which points at the page you are already on —
             and `/start/` appeared once in the whole document, inside a nav
             that was display:none. -->
        <nav
          class:list={[
            "flex flex-1 flex-wrap gap-x-4 gap-y-1 font-mono text-[0.8125rem]",
            !bare && "lg:hidden",
          ]}
          aria-label="Sections"
        >
          {
            flat.slice(1).map((item) => (
              <a
                href={item.href}
                aria-current={here === item.href ? "page" : undefined}
                class:list={[
                  "underline-offset-4 hover:underline",
                  here === item.href ? "text-on-surface" : "text-on-surface-variant",
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <!-- Hidden below lg on a documentation page, where the wrapping
             section nav needs the room and the footer carries the same link.
             Never hidden on the landing page: it is where a reader goes to
             obtain a library that is not published anywhere else. -->
        <a
          class:list={[
            "ml-auto font-mono text-[0.8125rem] text-on-surface-variant underline-offset-4 hover:underline",
            !bare && "hidden lg:block",
          ]}
          href="https://github.com/maroonedog/waypoint">GitHub</a
        >
      </div>
    </header>

    {
      bare ? (
        <main
          data-register={register}
          class="is-landing mx-auto max-w-5xl px-6 pt-20 pb-20 sm:pt-24"
        >
          <slot />
        </main>
      ) : (
        <div class="mx-auto grid max-w-[92rem] gap-x-10 px-4 sm:px-6 lg:grid-cols-[13rem_minmax(0,1fr)] wide:grid-cols-[13rem_minmax(0,1fr)_13rem]">
          <nav
            class="hidden lg:sticky lg:top-14 lg:block lg:h-[calc(100vh-3.5rem)] lg:overflow-y-auto lg:py-10"
            aria-label="Documentation"
          >
            {SECTIONS.map((section) => (
              <div class="mb-6">
                <p class="label">{section.group}</p>
                <ul class="mt-2 grid gap-0.5">
                  {section.items.map((item) => (
                    <li>
                      {/* The one place the mark's geometry is used. Hollow on
                          hover, filled on the page you are on — the place is
                          drawn before the value arrives in it, which is the
                          sentence this library is. It replaces a filled pill
                          that said nothing and could have sat on any site.
                          See `.index-link` in styles.css. */}
                      <a
                        href={item.href}
                        aria-current={here === item.href ? "page" : undefined}
                        class="index-link"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>

          <main
            data-register={register}
            class="min-w-0 max-w-[54rem] pt-16 pb-20 lg:pt-10"
          >
            <slot />
          </main>

          <aside
            class="hidden wide:sticky wide:top-14 wide:block wide:h-[calc(100vh-3.5rem)] wide:overflow-y-auto wide:py-10"
            aria-label="On this page"
          >
            {/* A LINE DOWN THE LIST, and one segment of it lit. The rail said
                which sections a page has and never which one the reader was
                in, which is the half of "on this page" that is about the
                reader. The line is what the marker is measured against: an
                accent bar with nothing behind it reads as decoration, and the
                same bar interrupting a rule reads as a position. The label is
                indented to the links rather than the links out to it, so the
                rule starts under the words it belongs to. */}
            {/* 3.5 AND NOT 3, because a link clears the list's own rule and
                its 2px bar before its text starts: -1 + 2 + 12 is 13 from the
                ul's border box and 14 from the aside's edge. At `pl-3` the
                label started two pixels to the left of every word under it —
                measured at x=1205 against x=1207 before the change, and flush
                at 1207 after it. */}
            <p class="label pl-3.5">On this page</p>
            <ul
              id="on-this-page"
              class="mt-2 grid gap-1 border-l border-outline-variant"
            >
            </ul>
          </aside>
        </div>
      )
    }

    <footer
      class:list={[
        "px-6 pb-16",
        bare ? "mx-auto max-w-5xl" : "mx-auto max-w-[92rem] lg:pl-[14.5rem]",
      ]}
    >
      <!-- THE STATUS LINE IS THE POINT OF THIS FOOTER. Most library footers
           carry a version and a download count; this one has neither to carry,
           and saying so in the chrome of every page is more useful to a reader
           deciding than another link would be. It is set in the site's own
           label grammar — `qualifier: value`, the punctuation the library
           sells — so the footer demonstrates it rather than describing it. -->
      <div
        class="hairline flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3 pt-8"
      >
        <p class="caption">
          MIT licensed. Two resolvers ship — zod and{" "}
          <a class="link" href="https://luq.dev"
            >luq</a
          > — and they reach the contract by different roads: one is walked
          directly, the other is asked for a JSON Schema.
        </p>
        <p class="label shrink-0">
          <span class="qualifies">status</span><span class="colon">:</span>{" "}
          <span class="named">unpublished</span>
          <!-- The separator is punctuation between two facts, not a fact. It
               is hidden from a screen reader, and it takes the quiet ink
               rather than the boundary line: the line colour measures 3.43:1
               on paper in light and 3.34:1 in dark, which clears the floor for
               a drawn boundary and is under it for anything that is read. -->
          <span aria-hidden="true" class="px-2 text-on-surface-variant">·</span>
          <a
            class="link named"
            href="https://github.com/maroonedog/waypoint">GitHub</a
          >
        </p>
      </div>
    </footer>

    {
      !bare && (
        <script is:inline>
          // Built from the DOM: a hand-kept list of a page's own headings is a
          // list that goes stale the first time one is renamed. Ids are minted
          // here too, so a heading needs nothing at its call site.
          (function () {
            var rail = document.getElementById("on-this-page");
            if (!rail) return;
            // AN ISLAND'S HEADINGS ARE NOT THIS PAGE'S SECTIONS. The example
            // applications run on /examples/ and /showcase/ now, and each one
            // brings its own `h2` — "Open an account", "Send it" — so the rail
            // was offering twelve entries for a page with six sections, half
            // of them naming the inside of a form. An island is somebody
            // else's document mounted here; where it starts is a section of
            // this page, and what it says inside is not.
            var headings = Array.prototype.filter.call(
              document.querySelectorAll("main h2"),
              function (h) {
                return !h.closest("astro-island");
              }
            );
            if (headings.length < 2) {
              rail.parentElement.hidden = true;
              return;
            }
            headings.forEach(function (heading) {
              if (!heading.id) {
                heading.id = (heading.textContent || "")
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, "-")
                  .replace(/^-|-$/g, "");
              }
              var item = document.createElement("li");
              var link = document.createElement("a");
              link.href = "#" + heading.id;
              link.textContent = heading.textContent;
              // `-ml-px` so the lit 2px bar covers the list's own 1px rule
              // rather than sitting beside it and widening the line. What the
              // lit state looks like is in styles.css, keyed to
              // `aria-current` — the script sets one attribute, so the marker
              // a screen reader announces and the marker an eye sees cannot
              // come to disagree.
              link.className =
                "-ml-px block border-l-2 border-transparent pl-3 font-mono text-[0.75rem] leading-snug text-on-surface-variant hover:text-on-surface";
              item.appendChild(link);
              rail.appendChild(item);
            });

            // ==============================================================
            // Which section the reader is in.
            //
            // NOT AN IntersectionObserver, and the reason is this site's own
            // pages. An observer answers "which headings are on screen", and
            // a section taller than the viewport has none — /examples/ has
            // three of those, each a running form — so the marker would go
            // out exactly where the reader spends the most time.
            //
            // A line across the viewport answers the question that was
            // actually asked: the current section is the last one whose
            // heading has passed it. 96px puts the line just under the sticky
            // header and just past `scroll-margin-top`, so a heading arriving
            // from a click on this rail is already the current one.
            //
            // NOTHING IS MARKED ABOVE THE FIRST HEADING. A page opens with a
            // title and a lead, which belong to no section, and marking the
            // first one there would be the rail claiming to know something it
            // does not.
            // ==============================================================
            var links = rail.querySelectorAll("a");
            var LINE = 96;
            var marked = -1;

            function currentIndex() {
              var doc = document.documentElement;
              // The last section can be shorter than the gap under the line,
              // so its heading never crosses: at the bottom of the document
              // it is the current one by arithmetic rather than by scrolling.
              if (window.innerHeight + window.scrollY >= doc.scrollHeight - 2) {
                return headings.length - 1;
              }
              var found = -1;
              for (var k = 0; k < headings.length; k++) {
                if (headings[k].getBoundingClientRect().top > LINE) break;
                found = k;
              }
              return found;
            }

            function keepInRail(link) {
              var box = rail.parentElement;
              if (box.scrollHeight <= box.clientHeight) return;
              var l = link.getBoundingClientRect();
              var b = box.getBoundingClientRect();
              if (l.top < b.top) box.scrollTop += l.top - b.top;
              else if (l.bottom > b.bottom) box.scrollTop += l.bottom - b.bottom;
            }

            function mark() {
              var next = currentIndex();
              if (next === marked) return;
              if (marked >= 0) links[marked].removeAttribute("aria-current");
              marked = next;
              if (marked < 0) return;
              links[marked].setAttribute("aria-current", "location");
              keepInRail(links[marked]);
            }

            // Coalesced onto a frame, because the handler measures every
            // heading and a scroll fires far more often than the page is
            // painted. THIS IS THE PATH FOR THINGS THAT REPEAT, and only for
            // those: a hidden tab never paints, so a frame it asks for never
            // arrives — measured in a hidden pane, where `requestAnimationFrame`
            // did not fire once in 600ms. Anything that has to be right by the
            // time the reader looks calls `mark` itself, below.
            var pending = false;
            function request() {
              if (pending) return;
              pending = true;
              requestAnimationFrame(function () {
                pending = false;
                mark();
              });
            }

            mark();
            addEventListener("scroll", request, { passive: true });
            addEventListener("resize", request);

            // The once-each moments, marked without waiting for a frame. A
            // page opened in a background tab does its fragment jump while it
            // is hidden and is never scrolled before it is looked at, so the
            // frame that would have marked it is the one that never came.
            addEventListener("load", mark);
            addEventListener("hashchange", mark);
            addEventListener("visibilitychange", mark);

            // NOT EVERY MOVE IS A SCROLL. The islands on /examples/ hydrate
            // after this script runs, the page grows by thousands of pixels,
            // and the browser re-anchors a fragment on top of that — a
            // position the reader never scrolled to, so no scroll event
            // announces it. The body's own box is what changed, so that is
            // what to watch.
            if (typeof ResizeObserver === "function") {
              new ResizeObserver(request).observe(document.body);
            }
          })();
        </script>
      )
    }
  </body>
</html>
