---
// ===========================================================================
// CountsTable.astro — rendered from the baseline CI gates against.
//
// `config/form-baseline.json` is not a copy of the results; it IS the file the
// counts lane compares every run against, and `npm run bench:forms:check`
// fails the build when a single integer in it moves. Reading it here means a
// figure on this page is a figure a machine checked, and that the page cannot
// go stale while still looking authoritative.
//
// Every integer in the body of this table is one of those checked figures, so
// every one of them carries `.measured` — the colour styles.css reserves for a
// number this project took, and spends on nothing else.
// ===========================================================================
import baseline from "../../../config/form-baseline.json";
import { DENOMINATOR, PRIMARY, UNCONTROLLED, label } from "../subjects.ts";

/** Both of ours are highlighted; the point is the difference between them. */
const ours = (id: string): boolean => id === PRIMARY || id === UNCONTROLLED;

interface Row {
  readonly shapeId: string;
  readonly subjectId: string;
  readonly scenarioId: string;
  readonly agreement: string;
  readonly commits: number;
  readonly changedFibers: number;
  readonly changedHostFibers: number;
  readonly validatorPasses: number;
  readonly pathsJudged: number;
}

const rows = (baseline as readonly Row[])
  .filter((row) => row.shapeId === "leaves-201" && row.scenarioId === "K1")
  .sort((one, other) => one.changedFibers - other.changedFibers);

const leaves = 201;
---

<p class="table-name font-medium">
  One keystroke that moves no verdict, {leaves} rendered fields
</p>

<div class="table-scroll">
  <table>
    <thead class="text-left">
      <tr class="hairline">
        <th class="pr-4">subject</th>
        <th class="num pr-4">commits</th>
        <th class="num pr-4">changed fibers</th>
        <th class="num pr-4">host fibers</th>
        <th class="num pr-4">validator passes</th>
        <th class="num">paths judged</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              "hairline",
              ours(row.subjectId) && "bg-surface-low",
            ]}
          >
            <td
              class:list={[
                "pr-4",
                ours(row.subjectId) && "font-medium",
              ]}
            >
              {label(row.subjectId)}
              {row.subjectId === DENOMINATOR && (
                <span class="text-on-surface-variant"> — the denominator</span>
              )}
            </td>
            <td class="num measured pr-4">{row.commits}</td>
            <td class="num measured pr-4">{row.changedFibers}</td>
            <td class="num measured pr-4">{row.changedHostFibers}</td>
            <td class="num measured pr-4">{row.validatorPasses}</td>
            <td class="num measured">{row.pathsJudged}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="caption">
  Generated from <code>config/form-baseline.json</code> — the file
  <code>npm run bench:forms:check</code> fails on when any integer in it moves.
</p>

<style>
  /* THE TWO GAPS THIS BLOCK OWNS, AND WHY IT OWNS THEM. styles.css spaces a
     PAGE — a heading and what hangs off it, a section and the one before it —
     and this component is dropped into the middle of one, between two
     paragraphs, where none of those rules reach. So the gaps are declared
     here, in the sheet's own tokens rather than in a utility carrying a
     number: /benchmark/ is set in the finding register, and a token still
     retunes with it where `mt-8` could not. */
  .table-name {
    margin-top: var(--gap-subsection);
  }
  .table-scroll {
    margin-top: var(--gap-heading);
    /* Six columns of a wide table scroll inside the block. A reference table
       that widens the page takes the running text with it. */
    overflow-x: auto;
  }
</style>
