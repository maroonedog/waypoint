---
// ===========================================================================
// CountsTable.astro — rendered from the baseline CI gates against.
//
// `config/form-baseline.json` is not a copy of the results; it IS the file the
// counts lane compares every run against, and `npm run bench:forms:check`
// fails the build when a single integer in it moves. Reading it here means a
// figure on this page is a figure a machine checked, and that the page cannot
// go stale while still looking authoritative.
// ===========================================================================
import baseline from "../../../config/form-baseline.json";
import { DENOMINATOR, PRIMARY, label } from "../subjects.ts";

interface Row {
  readonly shapeId: string;
  readonly subjectId: string;
  readonly scenarioId: string;
  readonly agreement: string;
  readonly commits: number;
  readonly changedFibers: number;
  readonly changedHostFibers: number;
  readonly validatorPasses: number;
  readonly pathsJudged: number;
}

const rows = (baseline as readonly Row[])
  .filter((row) => row.shapeId === "leaves-201" && row.scenarioId === "K1")
  .sort((one, other) => one.changedFibers - other.changedFibers);

const leaves = 201;
---

<p class="mt-8 font-medium">
  One keystroke that moves no verdict, {leaves} rendered fields
</p>

<div class="mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-on-surface-variant">
      <tr class="hairline">
        <th class="py-2 pr-4 font-medium">subject</th>
        <th class="py-2 pr-4 font-medium">commits</th>
        <th class="py-2 pr-4 font-medium">changed fibers</th>
        <th class="py-2 pr-4 font-medium">host fibers</th>
        <th class="py-2 pr-4 font-medium">validator passes</th>
        <th class="py-2 font-medium">paths judged</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr
            class:list={[
              "hairline",
              row.subjectId === PRIMARY && "bg-surface-low",
            ]}
          >
            <td
              class:list={[
                "py-2 pr-4",
                row.subjectId === PRIMARY && "font-medium",
              ]}
            >
              {label(row.subjectId)}
              {row.subjectId === DENOMINATOR && (
                <span class="text-on-surface-variant"> — the denominator</span>
              )}
            </td>
            <td class="py-2 pr-4">{row.commits}</td>
            <td class="py-2 pr-4">{row.changedFibers}</td>
            <td class="py-2 pr-4">{row.changedHostFibers}</td>
            <td class="py-2 pr-4">{row.validatorPasses}</td>
            <td class="py-2">{row.pathsJudged}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-3 text-xs text-on-surface-variant">
  Generated from <code>config/form-baseline.json</code> — the file
  <code>npm run bench:forms:check</code> fails on when any integer in it moves.
</p>
