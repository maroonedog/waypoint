---
// ===========================================================================
// ScenarioTable.astro — the same keystroke, when the verdict does move.
//
// The steady-state row is the one every benchmark shows. This is the one that
// separates the architectures: what it costs to put an error on the field just
// typed into, and what it costs to put one on a field nobody touched.
//
// Rendered from the same gated baseline as the counts table.
// ===========================================================================
import baseline from "../../../config/form-baseline.json";
import { DENOMINATOR, PRIMARY, UNCONTROLLED, label } from "../subjects.ts";

interface Row {
  readonly shapeId: string;
  readonly subjectId: string;
  readonly scenarioId: string;
  readonly agreement: string;
  readonly commits: number;
  readonly changedFibers: number;
}

const rows = baseline as readonly Row[];
const at = (subjectId: string, scenarioId: string): Row | undefined =>
  rows.find(
    (row) =>
      row.shapeId === "leaves-201" &&
      row.subjectId === subjectId &&
      row.scenarioId === scenarioId
  );

const SHOWN = [
  UNCONTROLLED,
  PRIMARY,
  DENOMINATOR,
  "react-hook-form-scoped",
  "react-hook-form-deps",
  "tanstack-form-level",
  "formik-fast-field",
];

const cell = (row: Row | undefined): string =>
  row === undefined
    ? "—"
    : row.agreement === "disagrees"
      ? "shows nothing"
      : `${row.commits} / ${row.changedFibers}`;
---

<p class="mt-10 font-medium">
  The same keystroke, when the verdict <em>does</em> move — 201 fields
</p>

<div class="mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-on-surface-variant">
      <tr class="hairline">
        <th class="py-2 pr-4 font-medium">subject</th>
        <th class="py-2 pr-4 font-medium">verdict unchanged</th>
        <th class="py-2 pr-4 font-medium">this field becomes wrong</th>
        <th class="py-2 font-medium">a rule reports elsewhere</th>
      </tr>
    </thead>
    <tbody>
      {
        SHOWN.map((id) => (
          <tr
            class:list={[
              "hairline",
              (id === PRIMARY || id === UNCONTROLLED) && "bg-surface-low",
            ]}
          >
            <td
              class:list={[
                "py-2 pr-4",
                (id === PRIMARY || id === UNCONTROLLED) && "font-medium",
              ]}
            >
              {label(id)}
            </td>
            <td class="py-2 pr-4">{cell(at(id, "K1"))}</td>
            <td class="py-2 pr-4">{cell(at(id, "K2"))}</td>
            <td class="py-2">{cell(at(id, "X1"))}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-3 text-xs text-on-surface-variant">
  commits / changed fibers. <code>shows nothing</code> means the subject never
  displayed the error at all, so there was no work for it to do.
</p>
