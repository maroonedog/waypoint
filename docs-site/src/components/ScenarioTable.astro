---
// ===========================================================================
// ScenarioTable.astro — the same keystroke, when the verdict does move.
//
// The steady-state row is the one every benchmark shows. This is the one that
// separates the architectures: what it costs to put an error on the field just
// typed into, and what it costs to put one on a field nobody touched.
//
// Rendered from the same gated baseline as the counts table.
// ===========================================================================
import baseline from "../../../config/form-baseline.json";
import { DENOMINATOR, PRIMARY, UNCONTROLLED, label } from "../subjects.ts";

interface Row {
  readonly shapeId: string;
  readonly subjectId: string;
  readonly scenarioId: string;
  readonly agreement: string;
  readonly commits: number;
  readonly changedFibers: number;
}

const rows = baseline as readonly Row[];
const at = (subjectId: string, scenarioId: string): Row | undefined =>
  rows.find(
    (row) =>
      row.shapeId === "leaves-201" &&
      row.subjectId === subjectId &&
      row.scenarioId === scenarioId
  );

const SHOWN = [
  UNCONTROLLED,
  PRIMARY,
  DENOMINATOR,
  "react-hook-form-scoped",
  "react-hook-form-deps",
  "tanstack-form-level",
  "formik-fast-field",
];

// A cell in this table is one of two things and they are not interchangeable:
// a pair of counts the harness recorded, or a sentence saying there was
// nothing to record. Only the first is a figure, and `.measured` is the
// colour styles.css keeps for a figure this project measured — so the two
// have to be told apart here rather than at the call site, where all that
// arrives is a string.
const cell = (row: Row | undefined): { text: string; figure: boolean } =>
  row === undefined
    ? { text: "—", figure: false }
    : row.agreement === "disagrees"
      ? { text: "shows nothing", figure: false }
      : { text: `${row.commits} / ${row.changedFibers}`, figure: true };

/** One row, resolved here so the markup below reads as the table it draws. */
const line = (id: string) => ({
  id,
  /** Both of ours are highlighted; the point is the difference between them. */
  ours: id === PRIMARY || id === UNCONTROLLED,
  unchanged: cell(at(id, "K1")),
  here: cell(at(id, "K2")),
  elsewhere: cell(at(id, "X1")),
});
---

<p class="table-name font-medium">
  The same keystroke, when the verdict <em>does</em> move — 201 fields
</p>

<div class="table-scroll">
  <table>
    <thead class="text-left">
      <tr class="hairline">
        <th class="pr-4">subject</th>
        <th class="num pr-4">verdict unchanged</th>
        <th class="num pr-4">this field becomes wrong</th>
        <th class="num">a rule reports elsewhere</th>
      </tr>
    </thead>
    <tbody>
      {
        SHOWN.map(line).map((row) => (
          <tr class:list={["hairline", row.ours && "bg-surface-low"]}>
            <td class:list={["pr-4", row.ours && "font-medium"]}>
              {label(row.id)}
            </td>
            <td class:list={["num pr-4", row.unchanged.figure && "measured"]}>
              {row.unchanged.text}
            </td>
            <td class:list={["num pr-4", row.here.figure && "measured"]}>
              {row.here.text}
            </td>
            <td class:list={["num", row.elsewhere.figure && "measured"]}>
              {row.elsewhere.text}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="caption">
  commits / changed fibers. <code>shows nothing</code> means the subject never
  displayed the error at all, so there was no work for it to do.
</p>

<style>
  /* The gaps this block owns, for the reason CountsTable states at length:
     styles.css spaces a page's own flow, and a component dropped between two
     of that page's paragraphs is outside it. The values are the sheet's gap
     tokens, so the finding register retunes them. */
  .table-name {
    margin-top: var(--gap-subsection);
  }
  .table-scroll {
    margin-top: var(--gap-heading);
    overflow-x: auto;
  }
</style>
