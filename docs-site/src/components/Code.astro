---
// ===========================================================================
// Code.astro — a code block cut into the page.
//
// Astro ships Shiki, so the highlighting is done at build time and the page
// carries no syntax-highlighting JavaScript. The theme follows the reader's
// colour scheme rather than being pinned to one, because a dark block on a
// light page is the thing people complain about.
//
// WHAT CHANGED, and why it mattered more than anything else on the site. This
// block is what a reader of a library's documentation actually looks at, and
// it was the one region of the page whose colours the site did not own: the
// GitHub themes brought their own grey ground, so a code block sat on the page
// as a foreign rectangle rather than as a recess in it. Now the ground and the
// frame are the site's — `--wp-sunk` behind a `--wp-line` boundary, the same
// 1px line every other edge on the site is drawn with — and Shiki is left to
// colour the tokens and nothing else.
//
// THE THEME PAIR WAS MEASURED, NOT PREFERRED, and the prettier candidates
// lost. Every theme the package ships was read, its token colours pulled out
// and each one rated against THIS site's code ground rather than against the
// white the theme assumes. What that found:
//   vitesse-light    #999999 punctuation at 2.47:1, #a0ada0 comments at 2.03
//                    — measured against #efefec, the recess before it was
//                    lifted; against the #f3f3f0 it is now, 2.56 and 2.10
//   vitesse-dark     #666666 punctuation at 3.40:1 — and unfixable, because
//                    4.5:1 against #666666 is unreachable from ANY darker
//                    ground, so no amount of tuning the recess saves it
//   everforest-light keywords at 2.0-2.8:1, 788 failing pairs on the site
//   one-light, min-light, rose-pine-dawn, light-plus — five to eight tokens
//                    under the floor each
// GitHub's high-contrast pair was the only matched pair that came through
// clean: nothing under 4.5:1 in dark (worst 9.19) and one token at 4.37 in
// light, which is why `--wp-sunk` is a step lighter than it started. They are
// louder than this site's own palette and that is the trade: a quiet block
// nobody can read is not quiet, it is unread.
//
// THE LABEL IS A QUALIFIED NAME. `file: AField.tsx`, `shell: install`,
// `app: application-form` — the qualifier quiet, the colon in the mark, the
// name in ink. It is the punctuation the library sells, so the chrome writes
// what the product writes. A label with no colon still sets correctly; the
// grammar is rewarded, not required.
// ===========================================================================
import { Code as Shiki } from "astro:components";

interface Props {
  readonly code: string;
  /**
   * The three this site writes. Narrower than Shiki's own union on purpose:
   * `string` does not satisfy it, and a typo in a language name should be a
   * build error rather than an unhighlighted block nobody notices.
   *
   * `sh` was missing, and the block it was missing for is the install on
   * /start/ — the first code a reader of this site meets. Passed as `ts`, it
   * was highlighted against the wrong grammar: `git` and `npm` set as
   * identifiers, `#` opening nothing.
   */
  readonly lang?: "ts" | "tsx" | "sh";
  /** Drop the top margin, for a block that sits directly under its own label. */
  readonly flush?: boolean;
  /**
   * Two or three words, set into a strip on the block itself. It is here so a
   * section can be a heading and a block of code: the sentence above that
   * only said what the code was becomes the strip. Anything longer than a few
   * words was never a label and belongs under the block as a caption.
   *
   * Written as `qualifier: name` it is typeset in three ranks; written as a
   * bare string it is typeset as the name alone.
   */
  readonly label?: string;
}

const { code, lang = "ts", flush = false, label } = Astro.props;

// Split on the FIRST colon only: `shell: npm run example:wizard` qualifies
// with "shell" and names the rest, which is the reading a reader gives it.
const cut = label === undefined ? -1 : label.indexOf(":");
const qualifies = cut > 0 ? label!.slice(0, cut) : undefined;
const named = cut > 0 ? label!.slice(cut + 1).trim() : label;
---

<figure class:list={["code-block", flush && "is-flush"]}>
  {
    label !== undefined && (
      <figcaption class="label code-label">
        {qualifies !== undefined && (
          <>
            <span class="qualifies">{qualifies}</span>
            <span class="colon">:</span>{" "}
          </>
        )}
        <span class="named">{named}</span>
      </figcaption>
    )
  }
  <Shiki
    code={code.trim()}
    lang={lang}
    themes={{ light: "github-light-high-contrast", dark: "github-dark-high-contrast" }}
    defaultColor={false}
  />
</figure>

<style is:global>
  /* THE BLOCK IS A RECESS, NOT A CARD: a 1px boundary and a ground one step
     under the page, with no shadow and the site's one radius. */
  .code-block {
    overflow: hidden;
    border: 1px solid var(--wp-line);
    border-radius: 3px;
    background: var(--wp-sunk);
  }

  /* Shiki writes both themes as custom properties; this picks one without a
     second stylesheet and without any script.

     THE BACKGROUND IS DELIBERATELY NOT TAKEN FROM THE THEME. `--shiki-*-bg`
     is the theme author's ground, and taking it put a second palette on the
     page — the one region whose colour the site did not choose. Tokens are
     Shiki's business; the surface under them is the site's. */
  .astro-code,
  .astro-code span {
    color: var(--shiki-light);
  }
  @media (prefers-color-scheme: dark) {
    .astro-code,
    .astro-code span {
      color: var(--shiki-dark);
    }
  }
  .astro-code {
    background: transparent !important;
    padding: 1.1rem 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.75;
  }

  /* The strip is part of the block, not a line above it: one container, a
     rule between the two halves rather than a second surface, so the name
     reads as attached to the code rather than floating over it. */
  .code-label {
    padding: 0.45rem 1.25rem;
    border-bottom: 1px solid var(--wp-line-faint);
  }
</style>
