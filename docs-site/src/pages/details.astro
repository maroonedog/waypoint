---
// ===========================================================================
// index.astro — code first, prose second.
//
// A reader deciding whether to use this wants to see what it looks like to
// write and what it does when they type in it. Both are on the page before
// any argument is made, and the arguments that remain are one sentence each.
//
// The headline is TYPED ADDRESSING, and it is one claim with two halves that
// have to be told together: the address is a compile-checked type before the
// leaf exists, AND the cell it names is already written. Either half alone is
// something somebody else also ships. The page used to lead on "a validator
// has no way to say what a field accepts", which Standard Schema's JSON Schema
// member made false, and on validator-neutrality, which Standard Schema
// commoditised — react-hook-form ships `standardSchemaResolver` and TanStack
// dropped its per-validator adapters at v1. Both are gone rather than softened.
// ===========================================================================
import TypeAndInstance from "../components/TypeAndInstance.astro";
import { servedPath } from "../i18n/locales.mjs";
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import LiveForm from "../demo/LiveForm.tsx";
import Proof from "../components/Proof.astro";
import proofMeta from "../demo/proof/index.json";
import { clone, whole, snippet } from "../demo/landing-code.js";
import AField from "../demo/proof/AField.tsx";
import CrossField from "../demo/proof/CrossField.tsx";
import AList from "../demo/proof/AList.tsx";
import Uncontrolled from "../demo/proof/Uncontrolled.tsx";
import SwitchAStepOff from "../demo/proof/SwitchAStepOff.tsx";
import aFieldSource from "../demo/proof/AField.tsx?raw";
import crossFieldSource from "../demo/proof/CrossField.tsx?raw";
import aListSource from "../demo/proof/AList.tsx?raw";
import uncontrolledSource from "../demo/proof/Uncontrolled.tsx?raw";
import switchAStepOffSource from "../demo/proof/SwitchAStepOff.tsx?raw";

// The code these blocks show lives in ../demo/landing-code.ts, because the
// Japanese page shows the same code and a snippet retyped into a second file
// is a snippet that drifts. What stays here is what is written rather than
// quoted: the title over each block and the one line under it.
const snippets = [
  { id: "field", title: "A field", note: "It subscribes to the cells it reads and to nothing else." },
  { id: "list", title: "A list", note: "There is no nested-array API." },
  { id: "cross-field", title: "A cross-field rule", note: "No deps array, no dependents list." },
  { id: "submit", title: "Submit", note: "" },
  {
    id: "uncontrolled",
    title: "Not waking React",
    note: "The same cell, subscribed imperatively. A keystroke costs 0 commits.",
  },
  {
    id: "participation",
    title: "Switching a subtree off",
    note: "It stops blocking submit and keeps its values.",
  },
];
// The differentiator, and the only table on this site whose cells are another
// library's behaviour. Every one of them is tsc's own verdict on ONE shared
// schema — shipments[*].lines[*].sku — compiled under TypeScript 5.9 strict,
// not read out of anybody's documentation.
//
// Two things a reader would expect here are absent because the compiler
// refused them: interpolated map indices are NOT a differentiator (RHF's
// `shipments.${number}...` and TanStack's are real union members, so a map
// index passes and a typo beside it is rejected, exactly as ours is), and
// "ours is checked and theirs is not" is false wherever the form's type is in
// scope. The difference is what happens when it is not.
//
// ONE MARK IN THE CELLS, AND IT IS ON THE ANSWER. A cell that says the
// compiler refused the line, or that the path was checked, gets the mark: a
// place was named and something answered for it. Everything else stays quiet,
// "no error" included, because an absence of a judgement is not a judgement
// and must not be drawn as one.
//
// IT USED TO BE THE VERDICT COLOUR ON "compile error", and that was backwards
// in the one place it mattered. In this table a compile error is the OUTCOME
// THE PAGE IS ARGUING FOR — the typo caught before it renders blank — so the
// red meant for a refusal sat on waypoint's own column and on the two
// libraries that also get it right, while the column that lets a typo through
// was the only quiet one. A reader scanning four columns reads red as wrong.
const LIBS = ["@maroonedog/waypoint", "react-hook-form 7.87", "TanStack Form 1.33", "Formik 2.4"];

/**
 * A row, and whether it distinguishes anything.
 *
 * `same` MARKS THE ROWS WHERE THIS LIBRARY IS NOT DIFFERENT, and it exists
 * because the table without it reads as a scorecard: six rows, one column
 * winning all six. Three of the six are rows where waypoint, react-hook-form
 * and TanStack Form all reject the line, and saying so in the table is worth
 * more than saying it in a caption underneath — a reader who scans the grid
 * and does not read the prose should still come away with the true shape,
 * which is that the difference is one thing and not six.
 */
interface PathRow {
  readonly theCase: string;
  readonly cells: readonly string[];
  /** waypoint, react-hook-form and TanStack Form all give the same verdict. */
  readonly same?: true;
}

const PATHS: readonly PathRow[] = [
  {
    theCase: "Typo deep in a static path",
    cells: ["compile error", "compile error", "compile error", "no error"],
    same: true,
  },
  {
    theCase: "Typo beside interpolated map indices",
    cells: ["compile error", "compile error", "compile error", "no error"],
    same: true,
  },
  {
    theCase: "Typo reading that field's error message",
    cells: ["compile error", "compile error, on the errors object", "compile error", "no error"],
    same: true,
  },
  {
    theCase: "Correct path, component two levels down, no props and no form object",
    cells: [
      "checked; value typed string | undefined",
      "no error — and neither is not.a.real.path.at.all",
      "no path compiles there at all",
      "no error — every string compiles",
    ],
  },
  {
    theCase: "Typo in that same props-free component",
    cells: ["compile error", "no error", "n/a — nothing compiles there", "no error"],
  },
  {
    theCase: "…after re-declaring or threading the form type by hand",
    cells: [
      "nothing to declare; it was already checked",
      "compile error, via useFormContext<Order>()",
      "compile error, via a typed form prop",
      "no error — the path stays unchecked",
    ],
  },
];

// The pair table: each entry is a component, its own source, and the two
// lines that frame it. The source is a ?raw import of the very file the
// component is, so the code shown and the code running are one file.
const byId = Object.fromEntries(proofMeta.map((one) => [one.id, one]));
const m = (id: string): { claim: string; watch: string } => byId[id];

// What a reader is actually shopping for. Every row is something the
// repository does or plainly does not, and the ones it does not say what to
// use instead — a capability list without them is an advertisement, and one
// that says only "no" leaves the reader exactly where they started.
const CAN: readonly (readonly [string, string, string, boolean])[] = [
  ["Validate a field", "Your schema already says it. One resolver call.", "/contract/", false],
  [
    "A rule across two fields",
    "One pass judges the whole root, so the message lands on the other field with no deps array.",
    "/validation/",
    false,
  ],
  [
    "Field arrays, nested",
    "useRows takes a concrete path and a row hands down its own address. There is no nested-array API.",
    "/api/#useRows",
    false,
  ],
  [
    "Fields behind a tab or an if",
    "Mounting is a subscription: a hidden field keeps its value, still validates and still blocks submit.",
    "/validation/",
    false,
  ],
  [
    "A multi-step form",
    "useParticipation takes a step out of what blocks submit and keeps its values; submit reports the paths that blocked it, including ones with no component.",
    "/validation/",
    false,
  ],
  [
    "Ask a server whether a handle is taken",
    "validate may return a promise. Passes are numbered, so an overtaken answer is dropped.",
    "/validation/",
    false,
  ],
  [
    "Messages in another language",
    "They come from your validator, so they are already yours. This library writes none.",
    "",
    false,
  ],
  [
    "Auto-save a draft",
    "Subscribe to the root cell: one notification per settled change, outside React.",
    "/api/",
    false,
  ],
  [
    "Two hundred fields that stay fast",
    "useUncontrolledField writes the DOM node instead of re-rendering: a keystroke is 0 commits.",
    "/runtime/",
    false,
  ],
  [
    "Your own inputs and design system",
    "No input and no class name of ours ships at all; a path type says which fields a widget accepts.",
    "/paths/",
    false,
  ],
  [
    "Swap the state container",
    "Five members over an opaque key, with a conformance kit that checks the four normative rules.",
    "/contract/",
    false,
  ],
  [
    "Server errors after a submit",
    "form.adoptIssues(issues) — the setError of this library. They are merged into every pass, so they reach their fields, are counted by errorCount and appear in blockedBy. One submit is refused by them and reports them; the next press asks the server again.",
    "/validation/",
    false,
  ],
  [
    "Validate on blur, or only on submit",
    "validateOn on createForm. After a rejected submit every setting judges on change again, so fixing the field the form just complained about clears it.",
    "/validation/",
    false,
  ],
  [
    "A file upload",
    'kind: "file", read off the document rather than off a vendor — a binary string is format: "binary" or contentEncoding: "binary" — so every validator that answers Standard Schema gets a file widget.',
    "/contract/",
    false,
  ],
  [
    "Import the bindings into a Next Server Component",
    'The ./react entry carries "use client", so it imports without a wrapper module of your own.',
    "",
    false,
  ],
  [
    "Debounce the validator",
    "There is no debounceMs. A pass can include synchronous and asynchronous rules, so a delay on the pass would delay the required-field message along with the network rule. Debounce inside the async rule; the second argument to adapter.validate is the AbortSignal a superseded pass is cancelled with.",
    "/validation/",
    true,
  ],
  [
    "Several files at once, or a maximum file size",
    'kind: "file" is ONE file. A multi-file pick is one event replacing a whole list, and rows() offers insert, remove and move with no replace-the-list edit. Byte bounds are dropped rather than carried, because constraints.minLength already means characters and array elements. Draw the multiple input yourself and keep the list with rows().',
    "",
    true,
  ],
  [
    "FormData, server actions, RSC data flow",
    'Every input already carries name set to its concrete path, so posting them arrives at the server as flat pairs keyed owner.name and items[0].quantity — but nothing here folds them back into a root, and nothing decides whether an absent checkbox means false, or whether "" is the empty string or an absent value. Decode it yourself, or post JSON from readRoot().',
    "",
    true,
  ],
  [
    "React Native",
    'The core entry has no DOM — it compiles with lib: ["ES2020"] and no DOM types, which is what the project split exists to check — but the bindings do: inputProps are DOM attributes like minLength and aria-describedby, and useUncontrolledField writes an HTMLInputElement. It would take an eighth entry point whose buildTextInputProps returned { value, onChangeText, onBlur }, and no uncontrolled hook at all. Until then: ./core, and write the bindings.',
    "",
    true,
  ],
  [
    "A devtools extension",
    "There is none. There is the seam one would be built on: createForm takes a store, a store is five members over an opaque key, and a store that records every write is an ordinary substitution rather than an instrumentation hook. The tape under the form above is exactly that, in 148 lines.",
    "/contract/",
    true,
  ],
];

const TRY = [
  ["Change billing", "the message appears on shipping"],
  ["Type in name", "only that row's counter moves"],
];
---

<Base
  title="Design notes — waypoint"
  description="Write useField('form:billing.postcode') in any component, at any depth. The compiler checks the string against your schema, and the cell it names is already written — one registry declaration, no props, no generic arguments, no register at mount."
>
  <!-- THE NAME, AND THEN THE CLAIM UNDER IT. It used to open with the claim
       set as the headline, on the reasoning that the name was already in the
       header. That gave the page a three-line sentence at display size — a
       paragraph pretending to be a headline — and left the thing a reader has
       to remember in 14px in a corner. -->
  <h1>Design notes</h1>

  <!-- THE TAGLINE SHOWS THE CALL. It used to read "A field's address exists
       before the component that draws it", which is the argument this page
       makes and not a sentence a stranger can act on: "address" is this
       library's own word for a path, and nothing in the line says what you
       write or what you get. A reader who has built a form knows what the
       call below costs them today. -->
  <p class="lead">
    Write <code>useField("form:billing.postcode")</code> in any component, at
    any depth. The compiler checks the string, and nothing had to be passed
    down to get there.
  </p>

  <!-- ONE FILL ON THE WHOLE SITE, AND IT IS THIS ONE. The mark is a line
       everywhere else; the single control a reader is meant to press is the one
       place it becomes a ground, and it means nothing if a second control
       beside it is filled too. So the secondary is drawn rather than filled,
       and it is drawn in `--wp-line` rather than the faint division: the faint
       one is a rule between rows, and the edge of something you press has to be
       visible enough to read as pressable. `mt-7` stays because nothing spaces
       a block after `.lead` — the sheet's rhythm starts at the first heading. -->
  <div class="mt-7 flex flex-wrap gap-3">
    <a
      class="rounded-[3px] bg-primary px-5 py-2.5 text-sm font-medium text-on-primary"
      href={servedPath("/runtime/")}>See how it behaves →</a
    >
    <a
      class="rounded-[3px] border border-outline px-5 py-2.5 text-sm font-medium"
      href={servedPath("/start/")}>Start</a
    >
    <a
      class="rounded-[3px] border border-outline px-5 py-2.5 text-sm font-medium"
      href="https://github.com/maroonedog/waypoint">GitHub</a
    >
  </div>

  <!-- WHAT IT IS, BEFORE WHAT IT ARGUES. This slot used to hold the
       mechanism — why the path type-checks, why the cell already exists —
       which is the argument the page makes and not an answer to the
       question a stranger arrives with. zod gives the slot three sentences
       under "What is Zod?"; drizzle the same under "What's Drizzle?".
       Three sentences, no comparison, nothing to agree or disagree with. -->
  <section>
    <h2>What waypoint is</h2>
    <p>
      A form library for React and Vue. You describe the form once with the
      validator you already use — zod, valibot, or anything you write a
      resolver for — and register that description once, in a single{" "}
      <code>declare module</code> block. After that any component reads a
      field by its path,{" "}
      <code>useField("form:billing.postcode")</code>, with nothing threaded
      down to it and no form object in scope.
    </p>
  </section>

  <p class="caption mt-6">
    <strong>Initial release line: 0.1.0.</strong> Production adoption is not
    established and APIs may change during 0.x. Install the package for use;
    clone the repository if you have access and want to develop it.
  </p>
  <Code code="npm install @maroonedog/waypoint" label="shell: install" lang="sh" flush />
  <Code code={clone} label="shell: source checkout (repository access required)" lang="sh" flush />

  <!-- THE CODE COMES BEFORE THE ARGUMENT, and this was in the wrong order for
       a while: the hero ran name, tagline, eighty words on why it works, and
       only then the controls. That is not what a reader of a library's front
       page is there for, and it is not what the libraries they already know do
       — zod opens with a tagline, a line saying what it is, and a code block;
       hono with a tagline and its runtimes. Name, one line, somewhere to
       press, and then the thing itself.

       The ten lines below used to be a section of their own, five screens
       down, under "All of that, in ten lines". A reader who had scrolled that
       far did not need them any more. -->
  <p class="caption mt-8">
    <strong class="text-on-surface">The whole of it, in ten lines.</strong>{" "}
    A resolver call, a registry declaration, and a component reading a field.
  </p>
  <Code code={whole} label="ts: the whole idea" flush />

  <!-- ================================================== proof -->
  <section>
    <h2>Five things, each beside itself running</h2>

    <!-- The `file` prop is the code block's label, so it is written in the
         label grammar — qualifier, colon, name. Code.astro splits on the first
         colon and sets `file` quiet, the colon in the mark and the file name in
         ink, which is the same three ranks a rendered address has. -->
    <Proof claim={m("a-field").claim} watch={m("a-field").watch} source={aFieldSource} file="file: AField.tsx">
      <AField client:visible />
    </Proof>

    <Proof claim={m("cross-field").claim} watch={m("cross-field").watch} source={crossFieldSource} file="file: CrossField.tsx">
      <CrossField client:visible />
    </Proof>

    <Proof claim={m("a-list").claim} watch={m("a-list").watch} source={aListSource} file="file: AList.tsx">
      <AList client:visible />
    </Proof>

    <Proof claim={m("uncontrolled").claim} watch={m("uncontrolled").watch} source={uncontrolledSource} file="file: Uncontrolled.tsx">
      <Uncontrolled client:visible />
    </Proof>

    <Proof claim={m("switch-a-step-off").claim} watch={m("switch-a-step-off").watch} source={switchAStepOffSource} file="file: SwitchAStepOff.tsx">
      <SwitchAStepOff client:visible />
    </Proof>
  </section>

  <!-- ================================================== live -->
  <section>
    <h2>The runtime, with its writes printed</h2>
    <p class="caption">
      A rule reporting onto a field nobody touched is not scarce — every
      whole-record validator does it. What differs is the bill. At 201 fields
      this costs one pass over 201 paths and 2 commits. The react-hook-form{" "}
      <code>deps</code> configuration costs two passes over 402 paths.{" "}
      <code>react-hook-form-scoped</code> costs 0 commits by showing no message
      at all, which the benchmark scores <em>disagrees</em> rather than a win.
    </p>

    <LiveForm client:load />

    <ul class="mt-5 grid gap-2 sm:grid-cols-2">
      {
        TRY.map(([what, then]) => (
          <li class="flex gap-2 text-sm leading-relaxed">
            <span class="font-medium whitespace-nowrap">{what}</span>
            <span class="text-on-surface-variant">— {then}</span>
          </li>
        ))
      }
    </ul>

    <p class="caption">
      The real library, built from source. The panel at the bottom is the cell
      store narrating itself — a recording store passed to{" "}
      <code>createForm</code>, which is the ordinary way to substitute one.
    </p>
  </section>

  <!-- ================================================== what you can build -->
  <section>
    <h2>What you can build with it</h2>
    <p class="caption">
      The struck-through rows are things it does not do, and each says what to
      reach for instead. They are in the table because leaving them out is how
      a table like this becomes an advertisement.
    </p>

    <div class="overflow-x-auto">
      <table>
        <thead class="text-left">
          <tr>
            <th class="pr-4">What you need</th>
            <th class="pr-4">How</th>
            <th>&nbsp;</th>
          </tr>
        </thead>
        <tbody>
          {
            CAN.map(([need, how, where, no]) => (
              <tr class="hairline">
                {/* A struck-through row is a refusal, which is what `.verdict`
                    is for. The rule is in the text's own colour rather than a
                    second one, so the row reads as one judgement instead of a
                    grey name with a red line drawn over it. */}
                <td class:list={["pr-4", no ? "verdict line-through" : "font-medium"]}>
                  {need}
                </td>
                <td class="pr-4 text-on-surface-variant">
                  {how}
                </td>
                <td class="whitespace-nowrap">
                  {where === "" ? (
                    ""
                  ) : (
                    <a
                      class="link"
                      href={servedPath(where)}
                    >
                      →
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ================================================== in code -->
  <section>
    <h2>Six things, in code</h2>
    <!-- min-w-0 on the item: a grid item defaults to min-width:auto, so the
         widest code block sizes the track and the page scrolls sideways on a
         phone. Same trap as the API entries. -->
    <div class="grid gap-6 lg:grid-cols-2">
      {
        snippets.map((one) => (
          <div class="min-w-0">
            <p class="mb-2 text-sm font-semibold">{one.title}</p>
            <Code code={snippet(one.id).code} lang={snippet(one.id).lang} flush />
            {one.note && (
              <p class="caption">{one.note}</p>
            )}
          </div>
        ))
      }
    </div>
    <p class="caption">
      Every hook and component, with its real signature, is on{" "}
      <a class="link" href={servedPath("/api/")}>API</a>.
    </p>
  </section>

  <!-- ================================================== the thesis -->
  <section>
    <h2>A field is a string, and the string is checked</h2>
    <p class="lead">
      react-hook-form and TanStack Form reject a typo too — while the form's
      type is in scope. Here it is in scope once, for the whole application: a
      leaf with no props, no form object and no import still rejects{" "}
      <code>shipments[0].lines[0].skuu</code>.
    </p>

    <!-- THE CAVEAT GOES ABOVE THE TABLE. Under it, a reader who scans the grid
         and moves on has already formed the impression the grid gives, and the
         grid gives a scorecard: four named libraries, one of them winning
         every row. The two things that make it not a scorecard — that three of
         the six rows show no difference, and that anybody can run it and
         disagree — have to arrive first.

         This is a stronger invitation than a comparison table can usually
         make: every cell is tsc's verdict on one schema, so it is falsifiable
         by typing, not a judgement to be argued with. -->
    <p class="caption mt-6">
      <strong class="text-on-surface">Three of these six rows show no
      difference</strong> between waypoint, react-hook-form and TanStack Form —
      they are marked. The difference is one thing, not six: what happens where
      the form's type is not in scope.
    </p>

    <p class="caption">
      Every cell is <code>tsc</code>'s own verdict on one shared schema, not a
      reading of anybody's documentation, so it can be checked by compiling
      rather than argued with. If a row is wrong or out of date — these are
      pinned versions, and any of them may have moved —{" "}
      <a class="link" href="https://github.com/maroonedog/waypoint/issues"
        >open an issue with the code that disagrees</a
      > and it will be corrected.
    </p>

    <div class="mt-[var(--gap-block)] overflow-x-auto">
      <table>
        <thead class="text-left">
          <tr>
            <th class="pr-4">Compiled, TypeScript 5.9 strict</th>
            {LIBS.map((lib) => <th class="pr-4">{lib}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            PATHS.map(({ theCase, cells, same }) => (
              <tr class="hairline">
                <td class="pr-4 font-medium">
                  {theCase}
                  {same && (
                    <span class="ml-2 font-normal whitespace-nowrap text-on-surface-variant">
                      (no difference)
                    </span>
                  )}
                </td>
                {cells.map((cell) => (
                  <td
                    class:list={[
                      "pr-4",
                      cell.startsWith("compile error") || cell.startsWith("checked")
                        ? "text-primary"
                        : "text-on-surface-variant",
                    ]}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="caption">
      One shared schema, <code>shipments[*].lines[*].sku</code>, compiled in all
      four. An interpolated <code>{"${i}"}</code> is a real member of
      react-hook-form's and TanStack's path unions too, which is why the second
      row is one of the three that separate nothing.
    </p>

    <p class="note">
      <strong>What it costs.</strong> One{" "}
      <code>declare module "@maroonedog/waypoint"</code> block, written against
      the ROOT entry rather than a framework's, so one registry serves every
      binding. It has to stay inside <code>tsconfig</code>'s{" "}
      <code>include</code>: delete it and every call site stops compiling, which
      is the failure direction you want.
    </p>

    <p class="note">
      <strong>Two limits.</strong> Register a second form and a keyless{" "}
      <code>useField</code> is checked against the union of both until you name
      the form key. And <strong>seven path segments are addressable, eight are
      not</strong> — a correct leaf deeper than that is rejected rather than
      accepted. What the union costs the compiler, where it stops,
      and the escape hatch for a subtree you do not address are measured in{" "}
      <!-- Mono, because the link text is a path in the repository rather than
           the name of a document: it is a thing the reader could type. -->
      <a
        class="link font-mono"
        href="https://github.com/maroonedog/waypoint/blob/master/docs/measurements-types.md"
        >docs/measurements-types.md</a
      >.
    </p>

    <p class="mt-8">
      <strong class="text-on-surface">The other half is that the cell the
      address names is already written.</strong> Every cell is seeded at{" "}
      <code>createForm</code> from the descriptor list, before any component
      mounts. A leaf appearing is a subscription and nothing else: no register,
      no unregister, no <code>shouldUnregister</code>, no ref callback. A field
      in a portal, in a lazy chunk or behind a condition is not a special case.
    </p>

    <p class="mt-8">
      An address checked at compile time that named nothing until a component
      mounted would be half an address. That is why these are one claim rather
      than two features.
    </p>
  </section>

  <!-- ================================================== measured -->
  <section>
    <h2>Measured, losses first</h2>
    <p class="caption">
      <strong class="text-on-surface">waypoint is behind on all three
      scenarios, at every size</strong> — the report says so in those words
      before it prints a table.
    </p>

    <!-- `.num measured` on the waypoint column and not on "beaten by": the
         fiber counts are figures this project measured and they are compared
         down the column, so they are right-aligned; the cell beside them is a
         zero and a library's name, and colouring a name as a measurement would
         claim the name was one. The head is not given a rule of its own — the
         sheet already draws the boundary under it. -->
    <div class="overflow-x-auto">
      <table>
        <thead class="text-left">
          <tr>
            <th class="pr-4">at 201 fields</th>
            <th class="pr-4">waypoint</th>
            <th class="pr-4">beaten by</th>
            <th>which was scored</th>
          </tr>
        </thead>
        <tbody>
          <tr class="hairline">
            <td class="pr-4">type a character, verdict unchanged</td>
            <td class="num measured pr-4">212 fibers</td>
            <td class="pr-4 font-mono">0 — waypoint (uncontrolled)</td>
            <td class="text-on-surface-variant">agrees</td>
          </tr>
          <tr class="hairline">
            <td class="pr-4">the typed field becomes wrong</td>
            <td class="num measured pr-4">424 fibers</td>
            <td class="pr-4 font-mono">0 — react-hook-form-on-submit</td>
            <td class="text-on-surface-variant">agrees at submit only</td>
          </tr>
          <tr class="hairline">
            <td class="pr-4">a rule reports elsewhere</td>
            <td class="num measured pr-4">424 fibers</td>
            <td class="pr-4 font-mono">0 — react-hook-form-scoped</td>
            <td class="verdict">disagrees</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="caption">
      Every integer here is gated: CI fails when one of them moves.{" "}
      <a class="link" href={servedPath("/benchmark/")}
        >What the benchmark can and cannot see →</a
      >
    </p>
  </section>

  <!-- ================================================== status -->
  <section class="rounded-[3px] border border-outline-variant p-6">
    <p class="label">Where it stands</p>
    <p class="mt-3">
      <strong>Initial release line: 0.1.0. Releases are explicit and production
      adoption is not established.</strong>
    </p>
    <p class="caption">
      Runtime tests, compile-time programs and interactive examples verify the
      behavior. A field whose key contains a dot cannot be addressed. Validation
      uses the whole root by default; optional partial execution depends on the
      adapter. See <a class="link" href={servedPath("/validation/")}>validation</a> for scope
      and dependency handling.
    </p>
  </section>
  <section id="type-registration">
    <h2>Why register the type?</h2>
    <p>A shared React context cannot carry each form's generic type to arbitrary
      descendants. Module augmentation makes the schema available to path types
      throughout the compilation; the provider selects the runtime instance.</p>
    <p>The tradeoff is a global registry: dependencies can contribute keys, and
      declarations must be included in your TypeScript program.</p>
    <TypeAndInstance />
  </section>
