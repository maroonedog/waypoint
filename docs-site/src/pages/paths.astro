---
// ===========================================================================
// paths.astro — how a path gets a type, and why it took a registry.
//
// The page exists because the answer is counter-intuitive: the types do not
// travel with the form. Written as the problem first, since the design only
// reads as reasonable once the constraint that forced it is on the page.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";


const registration = `
// src/waypoint-forms.ts — one file, one declaration, one time.
const orderAdapter = zodFormResolver(orderSchema);

declare module "@maroonedog/waypoint" {
  interface WaypointForms {
    form: typeof orderAdapter;
  }
}
`;

const usage = `
// Any component, at any depth. It imports nothing from the file above.
const postcode = useField("form:billing.postcode");  // string | undefined
const typo     = useField("form:billing.postcod");   // compile error
const sku      = useField("form:items[0].sku");      // a place, checked as its rule
const computed = useField(\`form:items[\${i}].sku\`);   // a computed index is fine
const spliced  = useField(\`form:items[\${s}].sku\`);   // compile error: s is a string
`;

const rows = `
// A row hands down its own address, and the address carries a type:
// \`row.path\` is \`form:shipments[\${number}]\`, not \`string\`.
{shipments.rows.map((shipment) => (
  <Lines key={shipment.key} at={shipment.path} />
))}

function Lines({ at }: { at: \`form:shipments[\${number}]\` }) {
  const lines = useRows(\`\${at}.lines\`);          // checked
  return lines.rows.map((line) => (
    <Text key={line.key} at={\`\${line.path}.sku\`} />   // checked, three levels down
  ));
}
`;

const several = `
declare module "@maroonedog/waypoint" {
  interface WaypointForms {
    order: typeof orderAdapter;
    profile: typeof profileAdapter;
  }
}

useField("order:items[0].sku");
useField("profile:items[0].sku");  // compile error: profile has no items
useField("items[0].sku");          // compile error: two forms, so say which
`;

const dynamic = `
// A schema built from a response, or generated by a benchmark harness.
declare module "@maroonedog/waypoint" {
  interface WaypointForms {
    form: FormAdapter<unknown, string>;
  }
}
`;

const viewTypes = [
  [
    "FormPath",
    "Every registered PLACE, containers included.",
    "A widget that takes whatever it is handed.",
  ],
  [
    "FormPathTo<string>",
    "Only the paths whose value is a string.",
    "A text input. Hand it a number field and it does not compile.",
  ],
  [
    "FormPathOver<'postcode' | 'city'>",
    "Only the prefixes that have all of those underneath.",
    "An address section placed at both billing and shipping.",
  ],
];
---

<Base
  title="Typed paths — waypoint"
  description="One React context serves every form, so the context cannot be generic and a path union cannot travel through it. The types are registered once by the application instead, and a component ten levels down is checked without being handed anything."
>
  <h1>Typed paths</h1>

  <p class="lead">Register your schema once. Field paths, including array indices, are checked at compile time.</p>

  <h2>One declaration, once</h2>

  <Code code={registration} label="file: src/waypoint-forms.ts" />
  <Code code={usage} label="any component, any depth" lang="tsx" />

  <p class="caption"><code>form</code> names the registered form. With one form, the prefix is optional. Registration applies to the whole TypeScript compilation, including declarations from dependencies. Without a registration, hooks are refused.</p>

  <p>Keep the declaration within your tsconfig's include. Components need not import it;
    the component creating the form imports the adapter value.</p>
  <p><a class="link" href="/details/#type-registration">Why register the type? →</a></p>

  <h2>Interpolated paths stay checked</h2>

  <Code code={rows} label="three levels inside a list" lang="tsx" />

  <h2>Several forms are several keys</h2>

  <Code code={several} label="two forms, two keys" />

  <p class="caption">With multiple forms, every path needs a prefix, including component props and row paths.</p>

  <p class="caption">Set <code>key</code> when creating a named form. Its provider rejects paths naming a different form.</p>

  <p class="caption">A prefix must precede the first <code>.</code> or <code>[</code>. Thus <code>byId.a:b.amount</code> is an ordinary path, not a form prefix.</p>

  <h2>Path types for the view layer</h2>

  <div class="overflow-x-auto">
    <table>
      <thead class="text-left">
        <tr>
          <th class="pr-4">Type</th>
          <th class="pr-4">What it is</th>
          <th>Where it goes</th>
        </tr>
      </thead>
      <tbody>
        {
          /* The first row takes no rule: the stylesheet already draws the
             boundary line under the header, and a faint rule immediately
             below it reads as one thick smudge rather than as two ranks. */
          viewTypes.map(([name, what, where], row) => (
            <tr class:list={[row > 0 && "hairline"]}>
              <td class="pr-4 font-mono">{name}</td>
              <td class="pr-4">{what}</td>
              <td>{where}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="caption">These types are derived from the registered schema.</p>

  <h2>Depth and compiler cost</h2>
  <p>Paths support up to <strong>seven segments</strong>; deeper fields are not addressable.
    <code>OpaqueObject</code> stops traversal at a container while keeping its value type.
    Invalid paths can be expensive for the compiler to explain.</p>
  <p><a class="link" href="https://github.com/maroonedog/waypoint/blob/master/docs/measurements-types.md">Compiler measurements and limits →</a></p>

  <h2>A schema nobody wrote down</h2>

  <Code code={dynamic} label="a schema with no static shape" />

  <p class="caption">
    <code>ConcretePath&lt;string&gt;</code> is <code>string</code>, so that
    form is back to unchecked paths — by its own declaration, in one place a
    reader can find.
  </p>

  <h2>At run time none of this exists</h2>
  <p>
    Whether a path is real is the <em>store's</em> question, and every caller —
    every hook, every <code>&lt;Field&gt;</code> and every non-React consumer —
    funnels through <code>form.field()</code>.
  </p>

  <!-- Quoted machine output, so it is drawn the way Code.astro draws a code
       block: the sunk ground behind a boundary line, no shadow, the one
       radius. `.verdict` because what the box contains is a judgement the
       library made about a path, which is the colour's whole job. -->
  <div class="mt-6 rounded-[3px] border border-outline bg-surface-low p-5">
    <p class="verdict font-mono text-xs leading-relaxed break-words">
      [waypoint] "order:billing.postcod" is not a field this form has, so it
      will draw nothing and validate nothing. Did you mean: order:billing.postcode,
      order:billing, order:billing.city?
    </p>
  </div>

  <p class="caption">An unknown path warns once and produces an inert field. Validation still checks the whole root and can block submission.</p>
</Base>
