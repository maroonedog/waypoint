---
// ===========================================================================
// validation.astro — the claims that were being re-argued on five pages.
//
// Each of these was thirty words somewhere else: on the home page, on the
// runtime page, in an API summary. They are one owner now, and every other
// page links here rather than making the argument again in its own words —
// two owners of one claim is how two pages come to disagree.
//
// Every claim below was checked against the test that pins it. Where a test
// pins something narrower than the claim wanted to say, the claim was cut
// down to the test.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";

const crossField = `
// The schema the live demo on this site runs on.
.superRefine((value, ctx) => {
  if (value.billing.postcode !== value.shipping.postcode) {
    ctx.addIssue({
      code: "custom",
      path: ["shipping", "postcode"],   // NOT the field being typed in
      message: "Does not match billing",
    });
  }
})
`;

const unrendered = `
// No React in this test at all. Two fields, neither of them mounted.
const outcome = await form.submit(save);

outcome.submitted;   // false — the handler never ran
outcome.blockedBy.map((issue) => issue.path).sort();
// ["owner.email", "owner.name"]
`;

const participation = `
const form = useForm();

useParticipation(form, "shipping", !sameAsBilling);
`;

const submitTypes = `
interface SubmitOutcome {
  readonly submitted: boolean;
  /** Empty when the form was handed over. */
  readonly blockedBy: readonly FormIssue[];
}

type SubmitHandler = (root: unknown) => void | Promise<void>;
`;

const asyncOne = `
const adapter = {
  fields: base.fields,
  async validate(root) {
    const local = base.validate(root);
    const taken = await isHandleTaken(root.handle);
    return taken
      ? [...local, { path: "handle", message: "Already taken" }]
      : local;
  },
};
`;

const numbered = `
field.setValue("Ad");    // pass 1 leaves, asking the server
field.setValue("Ada");   // pass 2 leaves
// pass 2 answers -> committed
// pass 1 answers -> DROPPED. It describes a root that is no longer there.
`;

// Read out of config/form-baseline.json: subject form-contract-use-field,
// scenario K1 — one keystroke whose verdict does not move.
const cost = [
  ["31", "1", "31"],
  ["61", "1", "61"],
  ["201", "1", "201"],
];

// Measured with a counting adapter around the real zod resolver.
const triggers = [
  ["field.setValue(next)", "1", "Coalesced: many writes in one turn are one pass."],
  ["rows.insert / remove / move", "1", "Each edit changes the root — a refused edit does not."],
  ["field.setParticipating(b)", "1", "What blocks a submit changed."],
  ["form.reset(...)", "1", "The new root has not been judged yet."],
  ["form.validate()", "1", "Immediately, not on the microtask."],
  ["field.issuesFor(candidate)", "1", "On a probe root. Writes nothing at all."],
  ["form.submit(handler)", "1", "Immediately, before the handler is considered."],
  ["form.adoptIssues(issues)", "0", "Committed off the last pass, so a server's answer does not wait behind the validator's."],
  ["field.markTouched()", "0 or 1", "1 under validateOn: \"blur\" — that is the blur. Otherwise touched is display state."],
  ["createForm(...)", "0", "Nothing is judged until something asks."],
];

/** Which moments a VALUE EDIT asks at. Everything else is unconditional. */
const moments = [
  ["\"change\"", "the default", "A pass follows every keystroke, coalesced to one per settled turn."],
  ["\"blur\"", "markTouched()", "setValue asks for nothing; the blur asks."],
  ["\"submit\"", "submit() only", "Neither asks. errorCount is 0 until the first submit."],
];
---

<Base
  title="Validation — form-contract"
  description="One pass judges the whole root on every settled change. That is what lets a rule report against a field that did not move, what lets an unrendered field block a submit — and what it costs."
>
  <h1 class="text-3xl font-bold sm:text-4xl">Validation</h1>

  <p class="lead">
    <strong class="text-on-surface">Every settled change judges the whole
    root.</strong> That is what lets a rule report against a field that did not
    move, and what lets a field nobody rendered still block a submit. It is
    also what it costs.
  </p>

  <h2 class="mt-16 text-2xl font-bold">A rule that spans two fields</h2>
  <Code code={crossField} label="the demo's own schema" />

  <p class="caption">
    <strong class="text-on-surface">Reporting onto a field nobody touched is
    not scarce</strong> — every whole-record validator does it, and the ones
    beside this in the benchmark can all be configured to. What is on the table
    is the bill. Nothing in your application lists which field depends on which:
    the demo on the <a class="text-primary underline underline-offset-4" href="/"
      >home page</a
    > runs exactly that schema, and the rule goes on reading shipping when its
    component is <em>not mounted</em>. The benchmark asks every subject for it
    as scenario X1: form-contract pays one whole-root pass, the react-hook-form{" "}
    <code>deps</code> configuration pays two passes and 402 paths judged, and{" "}
    <code>react-hook-form-scoped</code> is scored <em>disagrees</em> at all
    three sizes because it showed no message at all.
  </p>

  <h2 class="mt-16 text-2xl font-bold">A field nobody has rendered</h2>
  <p class="mt-3 leading-relaxed text-on-surface-variant">
    A field behind a tab, a lazy chunk or an <code>if</code> keeps its value,
    still blocks a submit, and paints the current value and the current error
    on its first render when it comes back.
  </p>

  <Code code={unrendered} label="no React in this test" />

  <p class="caption">
    <code>blockedBy</code> carries the path, so an application can open the
    right section instead of disabling a button with no explanation.
  </p>

  <h2 class="mt-16 text-2xl font-bold">Hiding a section without throwing its data away</h2>
  <Code code={participation} label="switching a subtree off" />

  <div class="mt-5 overflow-x-auto">
    <table class="w-full text-sm">
      <tbody>
        <tr class="hairline">
          <td class="w-40 py-3 pr-4 align-top font-medium">Changes</td>
          <td class="py-3 align-top leading-relaxed text-on-surface-variant">
            <code>errorCount</code> drops that subtree's issues; a submit is no
            longer blocked by them; a dormant field's own issues cell reads
            empty.
          </td>
        </tr>
        <tr class="hairline">
          <td class="w-40 py-3 pr-4 align-top font-medium">Does not change</td>
          <td class="py-3 align-top leading-relaxed text-on-surface-variant">
            The values in <code>readRoot()</code>; that the pass judges the
            subtree at all; the count once it is switched back on — the hook's
            teardown puts it back.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 class="mt-16 text-2xl font-bold">What submit says when it refuses</h2>
  <Code code={submitTypes} label="what submit resolves to" />

  <p class="caption">
    The handler runs only when nothing blocks. A handler that throws does not
    resolve — submit rejects — and the attempt still counts, so{" "}
    <code>submitCount</code> goes up either way.
  </p>

  <h2 class="mt-16 text-2xl font-bold">A validator that has to ask something</h2>
  <Code code={asyncOne} label="an adapter that asks a server" />
  <Code code={numbered} label="passes are numbered" />

  <p class="caption">
    <code>form.validating</code> is true only while a pass is in flight; a pass
    that <em>throws</em> leaves the previous verdict standing.
  </p>

  <p class="note">
    <strong>There is no debounce.</strong> One pass judges the whole root, so a
    delay on the pass would delay the required-field message along with the
    network rule — which is not a smaller version of what other libraries ship
    but a different and worse thing. Debounce inside the async rule, and take
    the second argument to <code>validate</code>: it is an{" "}
    <code>AbortSignal</code>, aborted the moment a newer pass starts, so a round
    trip whose answer is already going to be discarded can stop rather than
    finish. An adapter that declares only <code>root</code> is never handed one,
    and no <code>AbortController</code> is constructed for it.
  </p>

  <h2 class="mt-16 text-2xl font-bold">What asks for a pass, and what does not</h2>
  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-on-surface-variant">
        <tr class="hairline">
          <th class="py-2 pr-4 font-medium">Call</th>
          <th class="py-2 pr-4 font-medium">Passes</th>
          <th class="py-2 font-medium">Why</th>
        </tr>
      </thead>
      <tbody>
        {
          triggers.map(([call, n, why]) => (
            <tr class="hairline">
              <td class="py-3 pr-4 align-top font-mono text-xs whitespace-nowrap">
                {call}
              </td>
              <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">{n}</td>
              <td class="py-3 align-top leading-relaxed text-on-surface-variant">
                {why}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="note">
    <strong>A new form has not been judged.</strong> Build one from defaults
    that violate the schema and <code>errorCount</code> is still{" "}
    <code>0</code> — not because the form is clean, but because nothing has
    asked yet. Call <code>form.validate()</code> if a screen should open
    showing its errors.
  </p>

  <h2 class="mt-16 text-2xl font-bold">Which moments ask at all</h2>

  <p class="caption">
    <code>validateOn</code> goes on <code>createForm</code> and governs value
    edits. <code>reset</code>, <code>setParticipating</code> and a row edit
    still judge under every setting, because each changes <em>which</em> issues
    block rather than what one value is.
  </p>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-on-surface-variant">
        <tr class="hairline">
          <th class="py-2 pr-4 font-medium">validateOn</th>
          <th class="py-2 pr-4 font-medium">A value edit asks at</th>
          <th class="py-2 font-medium">What that means</th>
        </tr>
      </thead>
      <tbody>
        {
          moments.map(([setting, asks, what]) => (
            <tr class="hairline">
              <td class="py-3 pr-4 align-top font-mono text-xs whitespace-nowrap">
                {setting}
              </td>
              <td class="py-3 pr-4 align-top font-mono text-xs">{asks}</td>
              <td class="py-3 align-top leading-relaxed text-on-surface-variant">
                {what}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="note">
    <strong>It is on the form and never on a field.</strong> One pass judges the
    whole root, so a field set to <code>"blur"</code> would still be re-judged
    the moment any <em>other</em> field changed — there is no per-field pass to
    gate, and a per-field knob here would be a promise this runtime cannot
    keep. And after a <em>rejected</em> submit every setting judges on change
    again: a person fixing the field the form has just complained about has to
    watch the complaint go.
  </p>

  <h2 class="mt-16 text-2xl font-bold">Errors a server sent back</h2>

  <p class="caption">
    <code>form.adoptIssues(issues)</code> is the <code>setError</code> of this
    library, and the name differs because the behaviour does: the runtime does
    not merely display them, it owns them. They are merged onto every pass
    before anything is written, so they reach their fields, are counted by{" "}
    <code>errorCount</code> and appear in <code>blockedBy</code> — a hand-written
    issue cell was shown, not counted, and did not block. They are dropped by a
    write at the path, at an ancestor or at a descendant; by <code>reset</code>;
    and by the end of the next <code>submit()</code>, which that attempt was
    already refused by. One press is refused and told why; the next press asks
    the server again, which is what keeps an issue on a path nobody can type
    into — a declined card — from wedging the form for good.
  </p>

  <h2 class="mt-16 text-2xl font-bold">What it costs</h2>
  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-on-surface-variant">
        <tr class="hairline">
          <th class="py-2 pr-4 font-medium">fields rendered</th>
          <th class="py-2 pr-4 font-medium">validator passes</th>
          <th class="py-2 font-medium">paths judged</th>
        </tr>
      </thead>
      <tbody class="tabular-nums">
        {
          cost.map(([fields, passes, judged]) => (
            <tr class="hairline">
              <td class="py-3 pr-4 font-mono text-xs">{fields}</td>
              <td class="py-3 pr-4 font-mono text-xs">{passes}</td>
              <td class="py-3 font-mono text-xs">{judged}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="caption">
    One keystroke whose verdict does not move. Those integers live in{" "}
    <code>config/form-baseline.json</code> — the file{" "}
    <code>npm run bench:forms:check</code> compares every run against, and CI
    fails when one of them moves.{" "}
    <a class="text-primary underline underline-offset-4" href="/benchmark/"
      >What the benchmark can and cannot see →</a
    >
  </p>
</Base>
