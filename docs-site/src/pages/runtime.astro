---
// ===========================================================================
// runtime.astro — what a write touches, and when a verdict happens.
//
// The demo comes before the prose because it is better evidence than the
// prose. Every figure here was produced by running the runtime with a counting
// adapter, and a reader can reproduce two of them by typing.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import WriteFlow from "../components/WriteFlow.astro";
import LiveForm from "../demo/LiveForm.tsx";

const writing = `
form.field("owner.name").setValue("Grace");

form.rows("items").insert(2, { sku: "" });
form.rows("items").remove(0);
form.rows("items").move(0, 2);

form.reset();                 // back to the defaults it was built with
await form.submit(save);      // judges first; hands over only if nothing blocks
`;

const TRY = [
  [
    "Type in name",
    "Only that row's counter moves. The other four do not render at all.",
  ],
  [
    "Change billing",
    "The error lands on shipping, a field you did not touch. One pass judges the whole root and the diff writes wherever the verdict moved.",
  ],
  [
    "Switch to useUncontrolledField, then type a valid value",
    "The tape keeps printing and the counter does not move at all. Same cell, subscribed imperatively, writing the DOM node instead of re-rendering.",
  ],
  [
    "Watch validator passes",
    "One per settled change, however many fields that change touched.",
  ],
  [
    "Type a second character into billing",
    "The tape adds a root and a value and nothing else. The verdict did not move, so no issues cell is written and the row showing the error does not render.",
  ],
  [
    "Add a line, then remove the first row",
    "The tape shows B-2's value moving down a slot and the removed row's cells being forgotten. A value follows its row, because a row is addressed by identity rather than by index.",
  ],
];

const woken = [
  ["Writing the same value again", "nobody", "The store gates an Object.is-equal write."],
  [
    "A different value, same verdict",
    "that field's value",
    "Its issues cell is not written, so an error display beside it does not re-render.",
  ],
  [
    "A value that becomes invalid",
    "that field's value and issues",
    "The pass judged four hundred fields; it woke the one whose error moved.",
  ],
  ["Any of the above", "never another field", "Unless a rule actually moved that field's issues."],
];
---

<Base
  title="The runtime — waypoint"
  description="A live form you can type into, with a render counter on every row. One coalesced whole-root pass per settled change, and a verdict scattered back only onto the paths whose issues actually moved."
>
  <h1>How a value changes</h1>

  <p class="lead">Fields subscribe to their own values and state. Type below to see which rows render and which cells change.</p>

  <LiveForm client:load />

  <p class="caption">The log shows cell-store writes, newest first. A keystroke writes the root and field value; issues are written when the verdict changes.</p>

  <!-- Six things to try, drawn as a divided list rather than as six filled
       tiles: each entry is an instruction and its consequence, which is a pair
       of lines, not an object. The column gap is wide enough that two rules
       side by side read as two columns of one list. -->
  <div class="grid gap-x-8 sm:grid-cols-2">
    {
      TRY.map(([what, why]) => (
        <div class="hairline py-3">
          <p class="text-sm font-medium">{what}</p>
          <p class="caption">{why}</p>
        </div>
      ))
    }
  </div>

  <h2>The same runtime, on your machine</h2>

  <p>Run the development examples from a clone. They resolve waypoint to source, so edits reload without rebuilding the package.</p>

  <Code
    code={`git clone https://github.com/maroonedog/waypoint
cd waypoint && npm install

npm run example:showcase        # 23 inputs, six sections, one screen
npm run example:nested-arrays   # the same shape in four libraries, side by side
npm run docs:dev                # this site, with the form above`}
    label="shell: clone and run"
  />

  <h2>Typing that costs React nothing</h2>

  <div class="overflow-x-auto">
    <table>
      <thead class="text-left">
        <tr>
          <th class="pr-4">per keystroke, 201 fields</th>
          <th class="pr-4">verdict does not move</th>
          <th class="pr-4">the field becomes wrong</th>
          <th>a rule reports elsewhere</th>
        </tr>
      </thead>
      <tbody>
        <!-- Every cell in the three right-hand columns is a count this project
             took with a counting adapter, so the whole cell is `.measured` and
             set in the mono: the unit is part of the figure, and splitting the
             number out of "2 commits, 424" would leave the word behind in a
             face that says it was argued rather than counted. -->
        <tr class="hairline">
          <td class="pr-4 font-mono">useField</td>
          <td class="measured pr-4 font-mono">1 commit, 212 fibers</td>
          <td class="measured pr-4 font-mono">2 commits, 424</td>
          <td class="measured font-mono">2 commits, 424</td>
        </tr>
        <tr class="hairline">
          <td class="pr-4 font-mono">useUncontrolledField</td>
          <td class="measured pr-4 font-mono">0 commits, 0</td>
          <td class="measured pr-4 font-mono">1 commit, 212</td>
          <td class="measured font-mono">1 commit, 212</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="caption">Use <code>useField</code> for input masking and formatting. <code>useUncontrolledField</code> avoids value-driven renders but cannot transform values as you type. See the <a class="link" href="/benchmark/">benchmark</a> for comparisons.</p>

  <h2>What one keystroke does</h2>

  <WriteFlow />

  <h2>Writing</h2>

  <Code code={writing} label="every write goes through a handle" />



  <p class="note">
    What asks for a pass, and what does not — and what one costs — is on{" "}
    <a class="link" href="/validation/"
      >Validation</a
    >.
  </p>

  <h2>Who gets woken</h2>

  <div class="overflow-x-auto">
    <table>
      <thead class="text-left">
        <tr>
          <th class="pr-4">The write</th>
          <th class="pr-4">Woken</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        {
          woken.map(([what, who, note]) => (
            <tr class="hairline">
              <td class="pr-4">{what}</td>
              <td class="pr-4">{who}</td>
              <td class="text-on-surface-variant">{note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="caption">
    The pass still runs: <code>setValue</code> always asks for one.
  </p>


</Base>
