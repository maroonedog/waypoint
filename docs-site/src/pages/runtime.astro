---
// ===========================================================================
// runtime.astro — what a write touches, and when a verdict happens.
//
// The demo comes before the prose because it is better evidence than the
// prose. Every figure here was produced by running the runtime with a counting
// adapter, and a reader can reproduce two of them by typing.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import WriteFlow from "../components/WriteFlow.astro";
import LiveForm from "../demo/LiveForm.tsx";

const writing = `
form.field("owner.name").setValue("Grace");

form.rows("items").insert(2, { sku: "" });
form.rows("items").remove(0);
form.rows("items").move(0, 2);

form.reset();                 // back to the defaults it was built with
await form.submit(save);      // judges first; hands over only if nothing blocks
`;

const asking = `
field.issues                  // what they are now
await field.issuesFor("999")  // what they would be. Writes nothing at all.
field.validate()              // the form's own pass, filtered to this path

const { submitted, blockedBy } = await form.submit(save);
// blockedBy carries every blocking issue, including paths with no component,
// so an application can open the right section rather than disable a button.
`;

const asyncOne = `
// Passes are numbered, so a slow answer that has been overtaken is dropped.
field.setValue("Ad");    // pass 1 leaves, asking the server
field.setValue("Ada");   // pass 2 leaves
// pass 2 answers  -> committed
// pass 1 answers  -> DROPPED. It describes a root that is no longer there.
`;

const TRY = [
  [
    "Type in name",
    "Only that row's counter moves. The other four do not render at all — a component subscribes to the cells it reads and to nothing else.",
  ],
  [
    "Change billing",
    "The error lands on shipping, a field you did not touch, with no deps array anywhere. One pass judges the whole root and the diff writes wherever the verdict moved.",
  ],
  [
    "Switch to useUncontrolledField, then type a valid value",
    "The counter does not move at all. Same cell, subscribed imperatively, writing the DOM node instead of re-rendering.",
  ],
  [
    "Watch validator passes",
    "One per settled change, however many fields that change touched.",
  ],
];

// Measured with a counting adapter wrapped around the real zod resolver.
const triggers = [
  ["field.setValue(next)", "1", "Coalesced: many writes in one turn are one pass."],
  ["field.markTouched()", "0", "Touched is display state. Nothing to re-judge."],
  ["rows.insert / remove / move", "1", "Each edit changes the root."],
  ["field.setParticipating(b)", "1", "What blocks a submit changed."],
  ["form.reset(...)", "1", "The new root has not been judged yet."],
  ["form.validate()", "1", "Immediately, not on the microtask."],
  ["field.issuesFor(candidate)", "1", "On a probe root. Writes nothing at all."],
  ["form.submit(handler)", "1", "Immediately, before the handler is considered."],
  ["createForm(...)", "0", "Nothing is judged until something asks."],
];

const woken = [
  ["Writing the same value again", "nobody", "The store gates an Object.is-equal write."],
  [
    "A different value, same verdict",
    "that field's value",
    "Its issues cell is not written, so an error display beside it does not re-render.",
  ],
  [
    "A value that becomes invalid",
    "that field's value and issues",
    "The pass judged four hundred fields; it woke the one whose error moved.",
  ],
  ["Any of the above", "never another field", "Unless a rule actually moved that field's issues."],
];
---

<Base
  title="The runtime — form-contract"
  description="A live form you can type into, with a render counter on every row. One coalesced whole-root pass per settled change, and a verdict scattered back only onto the paths whose issues actually moved."
>
  <h1 class="text-3xl font-bold sm:text-4xl">How a value changes</h1>

  <p class="mt-6 leading-relaxed text-on-surface-variant">
    Values live in a flat, path-keyed cell space outside React. A component
    does not own a value and does not lift one: it subscribes to the cells it
    reads, and writes through a handle addressed by path. Below is that
    runtime, running — <strong class="text-on-surface">the number on each row
    is how many times that row has rendered.</strong>
  </p>

  <LiveForm client:load />

  <div class="mt-6 grid gap-3 sm:grid-cols-2">
    {
      TRY.map(([what, why]) => (
        <div class="rounded-lg bg-surface-low p-4">
          <p class="text-sm font-medium">{what}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-on-surface-variant">{why}</p>
        </div>
      ))
    }
  </div>

  <h2 class="mt-16 text-2xl font-bold">What one keystroke does</h2>

  <WriteFlow />

  <h2 class="mt-16 text-2xl font-bold">Writing</h2>
  <p class="mt-3 text-sm text-on-surface-variant">
    Every write goes through a handle. No <code>setState</code>, no form object
    to spread.
  </p>

  <Code code={writing} />

  <h2 class="mt-16 text-2xl font-bold">What asks for a pass, and what does not</h2>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-on-surface-variant">
        <tr class="hairline">
          <th class="py-2 pr-4 font-medium">Call</th>
          <th class="py-2 pr-4 font-medium">Passes</th>
          <th class="py-2 font-medium">Why</th>
        </tr>
      </thead>
      <tbody>
        {
          triggers.map(([call, n, why]) => (
            <tr class="hairline">
              <td class="py-3 pr-4 align-top font-mono text-xs whitespace-nowrap">
                {call}
              </td>
              <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">{n}</td>
              <td class="py-3 align-top leading-relaxed text-on-surface-variant">
                {why}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-6 rounded-lg border border-outline-variant p-5 leading-relaxed">
    <strong>A new form has not been judged.</strong> Build one from defaults
    that violate the schema and <code>errorCount</code> is still{" "}
    <code>0</code> — not because the form is clean, but because nothing has
    asked yet. Call <code>form.validate()</code> if a screen should open
    showing its errors.
  </p>

  <h2 class="mt-16 text-2xl font-bold">Who gets woken</h2>

  <div class="mt-6 overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="text-left text-on-surface-variant">
        <tr class="hairline">
          <th class="py-2 pr-4 font-medium">The write</th>
          <th class="py-2 pr-4 font-medium">Woken</th>
          <th class="py-2 font-medium">Note</th>
        </tr>
      </thead>
      <tbody>
        {
          woken.map(([what, who, note]) => (
            <tr class="hairline">
              <td class="py-3 pr-4 align-top leading-relaxed">{what}</td>
              <td class="py-3 pr-4 align-top font-mono text-xs">{who}</td>
              <td class="py-3 align-top leading-relaxed text-on-surface-variant">
                {note}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 class="mt-16 text-2xl font-bold">Asking, and asking slowly</h2>
  <p class="mt-3 text-sm text-on-surface-variant">
    <code>issuesFor</code> is a question, not an action — it writes nothing at
    all.
  </p>

  <Code code={asking} />
  <Code code={asyncOne} />

  <p class="mt-3 text-sm leading-relaxed text-on-surface-variant">
    While a pass is in flight <code>form.validating</code> is true. A pass that{" "}
    <em>throws</em> leaves the previous verdict standing: an error reaching the
    network is not evidence that the form became acceptable.
  </p>

  <p class="mt-10 text-sm leading-relaxed text-on-surface-variant">
    Every figure here came from running the runtime with a counting adapter
    around the real zod resolver. The demo is that same runtime.
  </p>
</Base>
