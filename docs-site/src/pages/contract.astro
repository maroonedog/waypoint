---
// ===========================================================================
// contract.astro — what a descriptor is, and what it deliberately is not.
//
// This page no longer argues that describing a field before a value exists is
// scarce. It is not: `getZodConstraint`, `parseSchema`, `superValidate`,
// `toFieldConfig` and `new ZodBridge` are all schema-in and value-free. So the
// page states the narrower thing that IS true: a JSON Schema is a TREE, a
// descriptor list is FLAT, and the walk between them is the work.
//
// THE "TWO ROADS" SECTION IS GONE, and that is the change this rewrite records.
// It used to close by contrasting them — zod walked directly, luq asked for a
// JSON Schema — and used the `z.date()` throw as the reason zod needed a road
// of its own. There is one road now. Both resolvers take their descriptors
// from the same generic walk over `~standard.jsonSchema`, so the page argues
// neutrality from the BUILD rather than from the existence of two
// implementations, and the `z.date()` throw appears as what the generic path
// costs rather than as a reason to avoid it.
//
// `FormResolver` is still gone from the code. The old worked example for why —
// that `luqFormResolver` is binary — stopped being true when the resolver went
// unary, so the block below shows the three real signatures and the page gives
// the reason that survives.
//
// The descriptor diff in `roads` is measured output, not prose: it is the
// three rows where a zod schema and its own JSON Schema disagree, produced by
// running both paths over the same schemas on zod 4.6.4. The three stages in
// `drawn` were likewise produced by running the zod resolver and
// buildInputProps, not typed out.
// ===========================================================================
import { servedPath } from "../i18n/locales.mjs";
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";

const drawn = `
// 1. the schema, which is the only place these are written
z.object({
  name:     z.string().min(3).max(20),
  role:     z.enum(["admin", "editor", "viewer"]),
  bio:      z.string().optional(),
  quantity: z.number().min(1).max(99),
})

// 2. what the resolver describes — before any value exists
{ path: "name",     kind: "string", isRequired: true,
  constraints: { minLength: 3, maxLength: 20 } }
{ path: "role",     kind: "string", isRequired: true, constraints: {},
  choices: [{ value: "admin", label: "admin" }, … ] }
{ path: "bio",      kind: "string", isRequired: false, constraints: {} }
{ path: "quantity", kind: "number", isRequired: true,
  constraints: { minimum: 1, maximum: 99 } }

// 3. what the input carries, with nobody writing it a second time
<input {...field.inputProps} />
// name      id="_r_0_name"  name="name"  required  type="text"  minlength="3"  maxlength="20"
// role      id="_r_1_role"  name="role"  required                 // no type: it draws a <select>
// bio       id="_r_2_bio"   name="bio"   type="text"              // declared nothing, so carries nothing
// quantity  id="_r_3_quantity"  name="quantity"  required  type="number"  min="1"  max="99"

// name, once it is wrong — and only once it is wrong
// aria-invalid="true"  aria-describedby="_r_0_name-error"
`;

const resolver = `
interface FormAdapter<T, TPath extends string = string> {
  readonly fields: readonly FormFieldDescriptor[];
  // The signal is aborted when a newer pass starts. An adapter that declares
  // one parameter is never handed one, and no AbortController is constructed.
  validate(root: unknown, signal?: ValidationSignal): MaybeAsync<readonly FormIssue[]>;
}

// One resolver reads both members off specs this package does not own:
standardFormResolver(schema)   // fields  ← schema["~standard"].jsonSchema.input({ target })
                               // validate ← schema["~standard"].validate(root)

// The vendor ones are that, plus what the specs have no member for:
zodFormResolver(schema)        // + kind "date", enum key labels, no synthetic int bounds
luqFormResolver(describable)   // + issue codes, and warnings graded out
`;

const neutral = `
// A validator that declares no JSON Schema cannot reach the unary overload.
// tsc, on an object carrying only ~standard.validate:

//   error TS2345: Argument of type 'StandardSchemaV1<Order>' is not assignable
//   to parameter of type 'StandardSchemaWithJSON<unknown>'.
//     Property 'jsonSchema' is missing in type 'StandardValidatorProps<Order>'
//     but required in type 'StandardDescriberProps<unknown>'.

// The way out says the true thing: the validator did not describe the form.
standardFormResolver(judging, { fields: myFields })
`;

const roads = `
// zod 4.6.4, both paths, over every schema in test/zod-resolver.test.mjs
// and test/zod-beyond-json-schema.test.mjs. Identical on every field
// but these three, which are what the second file pins:

                            vendor            generic, unaided
z.date()                    kind: "date"      kind: "unknown"
z.enum({ Admin: "admin" })  label: "Admin"    label: "admin"
z.number().int()            (no minimum)      minimum: -9007199254740991
`;

const descriptor = `
interface FormFieldDescriptor {
  readonly path: string;          // "owner.name", "items[*].quantity"
  readonly kind: FormFieldKind;   // string | number | boolean | date | file | array | object | unknown
  readonly isRequired: boolean;
  readonly constraints: FormFieldConstraints;    // minimum, maxLength, pattern, format, step…
  readonly choices?: readonly FormFieldChoice[]; // present only on a closed field
}
`;

const types = `
const adapter = zodFormResolver(
  z.object({ owner: z.object({ email: z.string() }) })
);

type Values = FormValues<typeof adapter>;   // { owner: { email: string } }
type Paths  = FormPaths<typeof adapter>;    // "owner" | "owner.email"

const good: Paths = "owner.email";
const typo: Paths = "owner.emial";          // compile error
`;

const weight = `
// src/resolver-zod — the only mention of zod in the built output.
import type * as z from "zod";
`;
---

<Base
  title="The contract — waypoint"
  description="A form adapter supplies descriptors and whole-root validation, with optional partial execution. Value and path types survive the adapter boundary."
>
  <h1>The contract</h1>

  <h2 id="valibot">Use Valibot</h2>
  <Code code={`npm install valibot @valibot/to-json-schema`} label="peer dependencies" lang="sh" />
  <Code code={`import * as v from "valibot";
import { valibotFormResolver } from "@maroonedog/waypoint/resolver-valibot";

const adapter = valibotFormResolver(v.object({
  email: v.pipe(v.string(), v.email("Enter a valid email")),
}));

declare module "@maroonedog/waypoint" {
  interface WaypointForms { form: typeof adapter }
}`} label="Valibot adapter" />
  <p>Uses the official JSON Schema converter for descriptors and preserves Valibot's
    issue <code>type</code> as a typed <code>issue.code</code>. All validation issues
    are collected even when global abort settings are enabled.</p>
  <p>Forms edit and submit input values, not transformed output. Parse the submitted
    value yourself when you need Valibot's transformed result.</p>
  <p>For async schemas or fields the converter cannot represent, pass
    <code>{"{ fields }"}</code> explicitly. Synchronous schemas can also pass
    <code>libraryOptions</code> to the converter. Without descriptors, the generic
    resolver warns and returns no fields; validation remains active.</p>
  <Code code={`const shape = v.object({ email: v.string() });
const asyncSchema = v.pipeAsync(shape,
  v.checkAsync(async (value) => await isAvailable(value.email), "Taken"));
const adapter = valibotFormResolver(asyncSchema, {
  fields: valibotFormResolver(shape).fields,
});`} label="Async validation (isAvailable is your server call)" />

  <p class="lead">A resolver turns a schema into field descriptors and a whole-root validator. Bindings use the descriptors for labels, input constraints, and accessibility attributes.</p>

  <h2>What a descriptor draws</h2>

  <Code code={drawn} label="schema → descriptor → input" />

  <p class="caption">IDs are scoped per hook call. Bounds appear only when declared by the schema; <code>aria-invalid</code> appears when the field has issues.</p>

  <h2>What a screen reader is handed</h2>
  <p>
    Both bindings hand back four bags, not one. <code>inputProps</code> carries
    the <code>id</code> — scoped by <code>useId</code>, so two forms on one page
    cannot collide — and <code>aria-describedby</code> naming the help line and
    then the message, in the order they are read. <code>labelProps</code> is the
    matching <code>htmlFor</code>; <code>errorProps</code> is that id and{" "}
    <code>role="alert"</code>; <code>descriptionProps</code> is{" "}
    <code>undefined</code> when the schema declared no description, so nothing
    ever points at an element you do not draw.{" "}
    <code>aria-required</code> is deliberately not emitted: <code>required</code>{" "}
    is already on the element, and the second copy of one fact is the copy that
    goes stale.
  </p>

  <p class="note">Render the error element even when empty so its live region can announce later updates. Automated accessibility checks do not replace testing with assistive technology.</p>

  <h2>Required members and partial execution</h2>

  <Code code={resolver} label="type: FormAdapter" />

  <p class="caption">Pass a resolver explicitly when creating the form. Its contract consists of field descriptors and validation.</p>
  <p>An optional <code>validatePartial(root, paths, signal?)</code> can execute
    only affected rules. It returns complete issue lists for replacement subtrees,
    including dependencies. See <a class="link" href={servedPath("/validation/")}>partial validation</a>
    for resolver support and fallback behavior.</p>

  <h2>Neutral by construction</h2>

  <p>The standard resolver reads both validation and JSON Schema from the validator. No vendor-specific adapter is needed when both interfaces are supported.</p>
  <p>
    <code>draft-2020-12</code> is asked for first and <code>draft-07</code> on a
    throw: the spec tells a library to throw on a target it does not support,
    and both drafts are in wide use.
  </p>

  <Code code={neutral} label="the degradation, in the type system" />

  <p class="caption">Without descriptors, validation still works but no fields are described. Missing schema interfaces produce a type error; failed converters or empty documents produce console warnings.</p>

  <h2>So why do two vendor resolvers remain?</h2>

  <Code code={roads} label="measured: zod 4.6.4" />

  <p class="caption">Vendor resolvers preserve details JSON Schema does not carry, illustrated above.</p>
  <p class="caption">Standard Schema issues contain a message and path, but no vendor error code. Vendor resolvers retain those codes while reusing the generic descriptor conversion.</p>

  <h2>One descriptor is one field</h2>

  <Code code={descriptor} label="type: FormFieldDescriptor" />

  <p class="caption">Each leaf has one descriptor; array rows share a wildcard descriptor. Constraints keep their declared values, including <code>RegExp</code>. The <code>kind</code> selects a widget and need not match the TypeScript value type.</p>

  <h2>The type survives</h2>

  <Code code={types} label="type: FormValues, FormPaths" />

  <p class="caption">
    The contract is neutral about direction: a type-first validator passes the
    type its rules were written against, a schema-first one passes what its
    schema infers, and both arrive as the same form.{" "}
    <a class="link" href={servedPath("/paths/")}
      >How a path gets its type →</a
    >
  </p>

  <h2>Bring your own validator, and your own copy of it</h2>

  <Code code={weight} label="file: src/resolver-zod" />

  <!-- The one margin this page still writes. `--gap-block` is carried by the
       code block itself and `--gap-heading` by whatever follows a heading; a
       wrapper that follows a code block is neither, so with no margin here the
       table would sit on the block above it. -->
  <div class="mt-5 overflow-x-auto">
    <table>
      <tbody>
        <tr class="hairline">
          <td class="w-40 pr-4 font-medium">At run time</td>
          <td class="text-on-surface-variant">
            Nothing — one <code>import type</code>, erased at build.
          </td>
        </tr>
        <tr class="hairline">
          <td class="w-40 pr-4 font-medium">At install time</td>
          <td class="text-on-surface-variant">
            zod is declared as a peer, so the copy you already installed is the
            one it describes; the resolver cannot pin a version or pull in a
            second.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <p class="caption">
    All three resolvers work alike now: each flattens the same tree, <code>$ref</code>{" "}
    and combinators included, into one descriptor per leaf through the same
    walk.
  </p>
  <p class="caption">
    That route is not free. Measured on zod 4.6.4: asking a schema containing{" "}
    <code>z.date()</code> for its JSON Schema throws{" "}
    <code class="verdict">Date cannot be represented in JSON Schema</code> and
    emits <strong class="text-on-surface">no property at all</strong>. One field
    loses the whole document, and it is the most common non-text widget in a
    real form. zod offers a way through, spelled{" "}
    <code>&#123; unrepresentable: "any" &#125;</code>, and{" "}
    <code>zodFormResolver</code> passes it on every call. The generic resolver
    forwards such an option but never invents one: it is the vendor's own
    vocabulary, and an unknown library may reject a key it does not know.{" "}
    <a class="link" href={servedPath("/start/")}
      >What each entry point gives you →</a
    >
  </p>
</Base>
