---
// ===========================================================================
// index.astro — code first, prose second.
//
// A reader deciding whether to use this wants to see what it looks like to
// write and what it does when they type in it. Both are on the page before
// any argument is made, and the arguments that remain are one sentence each.
//
// The headline is TYPED ADDRESSING, and it is one claim with two halves that
// have to be told together: the address is a compile-checked type before the
// leaf exists, AND the cell it names is already written. Either half alone is
// something somebody else also ships. The page used to lead on "a validator
// has no way to say what a field accepts", which Standard Schema's JSON Schema
// member made false, and on validator-neutrality, which Standard Schema
// commoditised — react-hook-form ships `standardSchemaResolver` and TanStack
// dropped its per-validator adapters at v1. Both are gone rather than softened.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import LiveForm from "../demo/LiveForm.tsx";
import Proof from "../components/Proof.astro";
import proofMeta from "../demo/proof/index.json";
import AField from "../demo/proof/AField.tsx";
import CrossField from "../demo/proof/CrossField.tsx";
import AList from "../demo/proof/AList.tsx";
import Uncontrolled from "../demo/proof/Uncontrolled.tsx";
import SwitchAStepOff from "../demo/proof/SwitchAStepOff.tsx";
import aFieldSource from "../demo/proof/AField.tsx?raw";
import crossFieldSource from "../demo/proof/CrossField.tsx?raw";
import aListSource from "../demo/proof/AList.tsx?raw";
import uncontrolledSource from "../demo/proof/Uncontrolled.tsx?raw";
import switchAStepOffSource from "../demo/proof/SwitchAStepOff.tsx?raw";

const whole = `
// 1. Any validator becomes a form description. One function, named by you.
const orderAdapter = zodFormResolver(orderSchema);

// 2. Its types, registered once for the whole application.
declare module "@maroonedog/waypoint/react" {
  interface FormTypeRegistry { form: typeof orderAdapter }
}

// 3. Any component, any depth. No props, no context type, no assertions.
const field = useField("form:billing.postcode");   //  string | undefined
const typo  = useField("form:billing.postcod");    //  compile error
`;

const snippets = [
  {
    title: "A field",
    note: "It subscribes to the cells it reads and to nothing else.",
    lang: "tsx" as const,
    code: `const field = useField("form:owner.name");

<input {...field.inputProps} />
<em>{field.issues[0]?.message}</em>`,
  },
  {
    title: "A list",
    note: "There is no nested-array API.",
    lang: "tsx" as const,
    code: `const items = useRows("form:items");

items.rows.map((row) => (
  <Sku key={row.key} at={\`\${row.path}.sku\`} />
))
items.insert(items.rows.length, { sku: "" });`,
  },
  {
    title: "A cross-field rule",
    note: "No deps array, no dependents list.",
    lang: "ts" as const,
    code: `.superRefine((value, ctx) => {
  if (value.billing.postcode !== value.shipping.postcode) {
    ctx.addIssue({
      path: ["shipping", "postcode"],   // not the field being typed in
      message: "Does not match billing",
    });
  }
})`,
  },
  {
    title: "Submit",
    note: "",
    lang: "ts" as const,
    code: `const { submitted, blockedBy } = await form.submit(save);

// blockedBy carries every blocking issue, including
// paths with no component on screen.`,
  },
  {
    title: "Not waking React",
    note: "The same cell, subscribed imperatively. A keystroke costs 0 commits.",
    lang: "tsx" as const,
    code: `const field = useUncontrolledField("form:owner.name");

<input defaultValue={field.defaultValue} ref={field.ref}
       onChange={field.onChange} onBlur={field.onBlur} />`,
  },
  {
    title: "Switching a subtree off",
    note: "It stops blocking submit and keeps its values.",
    lang: "ts" as const,
    code: `useParticipation(form, "form:shipping", !sameAsBilling);

// A rule comparing against it goes on reading it.`,
  },
];

// The differentiator, and the only table on this site whose cells are another
// library's behaviour. Every one of them is tsc's own verdict on ONE shared
// schema — shipments[*].lines[*].sku — compiled under TypeScript 5.9 strict,
// not read out of anybody's documentation.
//
// Two things a reader would expect here are absent because the compiler
// refused them: interpolated map indices are NOT a differentiator (RHF's
// `shipments.${number}...` and TanStack's are real union members, so a map
// index passes and a typo beside it is rejected, exactly as ours is), and
// "ours is checked and theirs is not" is false wherever the form's type is in
// scope. The difference is what happens when it is not.
const LIBS = ["@maroonedog/waypoint", "react-hook-form 7.87", "TanStack Form 1.33", "Formik 2.4"];

const PATHS: readonly (readonly [string, readonly string[]])[] = [
  [
    "Typo deep in a static path",
    ["compile error", "compile error", "compile error", "no error"],
  ],
  [
    "Typo beside interpolated map indices",
    ["compile error", "compile error", "compile error", "no error"],
  ],
  [
    "Typo reading that field's error message",
    ["compile error", "compile error, on the errors object", "compile error", "no error"],
  ],
  [
    "Correct path, component two levels down, no props and no form object",
    [
      "checked; value typed string | undefined",
      "no error — and neither is not.a.real.path.at.all",
      "no path compiles there at all",
      "no error — every string compiles",
    ],
  ],
  [
    "Typo in that same props-free component",
    ["compile error", "no error", "n/a — nothing compiles there", "no error"],
  ],
  [
    "…after re-declaring or threading the form type by hand",
    [
      "nothing to declare; it was already checked",
      "compile error, via useFormContext<Order>()",
      "compile error, via a typed form prop",
      "no error — the path stays unchecked",
    ],
  ],
];

// The pair table: each entry is a component, its own source, and the two
// lines that frame it. The source is a ?raw import of the very file the
// component is, so the code shown and the code running are one file.
const byId = Object.fromEntries(proofMeta.map((one) => [one.id, one]));
const m = (id: string): { claim: string; watch: string } => byId[id];

// What a reader is actually shopping for. Every row is something the
// repository does or plainly does not, and the ones it does not say what to
// use instead — a capability list without them is an advertisement, and one
// that says only "no" leaves the reader exactly where they started.
const CAN: readonly (readonly [string, string, string, boolean])[] = [
  ["Validate a field", "Your schema already says it. One resolver call.", "/contract/", false],
  [
    "A rule across two fields",
    "One pass judges the whole root, so the message lands on the other field with no deps array.",
    "/validation/",
    false,
  ],
  [
    "Field arrays, nested",
    "useRows takes a concrete path and a row hands down its own address. There is no nested-array API.",
    "/api/#useRows-",
    false,
  ],
  [
    "Fields behind a tab or an if",
    "Mounting is a subscription: a hidden field keeps its value, still validates and still blocks submit.",
    "/validation/",
    false,
  ],
  [
    "A multi-step form",
    "useParticipation takes a step out of what blocks submit and keeps its values; submit reports the paths that blocked it, including ones with no component.",
    "/validation/",
    false,
  ],
  [
    "Ask a server whether a handle is taken",
    "validate may return a promise. Passes are numbered, so an overtaken answer is dropped.",
    "/validation/",
    false,
  ],
  [
    "Messages in another language",
    "They come from your validator, so they are already yours. This library writes none.",
    "",
    false,
  ],
  [
    "Auto-save a draft",
    "Subscribe to the root cell: one notification per settled change, outside React.",
    "/api/",
    false,
  ],
  [
    "Two hundred fields that stay fast",
    "useUncontrolledField writes the DOM node instead of re-rendering: a keystroke is 0 commits.",
    "/runtime/",
    false,
  ],
  [
    "Your own inputs and design system",
    "No input and no class name of ours ships at all; a path type says which fields a widget accepts.",
    "/paths/",
    false,
  ],
  [
    "Swap the state container",
    "Five members over an opaque key, with a conformance kit that checks the four normative rules.",
    "/contract/",
    false,
  ],
  [
    "Server errors after a submit",
    "form.adoptIssues(issues) — the setError of this library. They are merged into every pass, so they reach their fields, are counted by errorCount and appear in blockedBy. One submit is refused by them and reports them; the next press asks the server again.",
    "/validation/",
    false,
  ],
  [
    "Validate on blur, or only on submit",
    "validateOn on createForm. After a rejected submit every setting judges on change again, so fixing the field the form just complained about clears it.",
    "/validation/",
    false,
  ],
  [
    "A file upload",
    'kind: "file", read off the document rather than off a vendor — a binary string is format: "binary" or contentEncoding: "binary" — so every validator that answers Standard Schema gets a file widget.',
    "/contract/",
    false,
  ],
  [
    "Import the bindings into a Next Server Component",
    'The ./react entry carries "use client", so it imports without a wrapper module of your own.',
    "",
    false,
  ],
  [
    "Debounce the validator",
    "There is no debounceMs. One pass judges the whole root, so a delay on the pass would delay the required-field message along with the network rule. Debounce inside the async rule; the second argument to adapter.validate is the AbortSignal a superseded pass is cancelled with.",
    "/validation/",
    true,
  ],
  [
    "Several files at once, or a maximum file size",
    'kind: "file" is ONE file. A multi-file pick is one event replacing a whole list, and rows() offers append, remove and move with no replace-the-list edit. Byte bounds are dropped rather than carried, because constraints.minLength already means characters and array elements. Draw the multiple input yourself and keep the list with rows().',
    "",
    true,
  ],
  [
    "FormData, server actions, RSC data flow",
    'Every input already carries name set to its concrete path, so posting them arrives at the server as flat pairs keyed owner.name and items[0].quantity — but nothing here folds them back into a root, and nothing decides whether an absent checkbox means false, or whether "" is the empty string or an absent value. Decode it yourself, or post JSON from readRoot().',
    "",
    true,
  ],
  [
    "React Native",
    'The core entry has no DOM — it compiles with lib: ["ES2020"] and no DOM types, which is what the project split exists to check — but the bindings do: inputProps are DOM attributes like minLength and aria-describedby, and useUncontrolledField writes an HTMLInputElement. It would take an eighth entry point whose buildTextInputProps returned { value, onChangeText, onBlur }, and no uncontrolled hook at all. Until then: ./core, and write the bindings.',
    "",
    true,
  ],
  [
    "A devtools extension",
    "There is none. There is the seam one would be built on: createForm takes a store, a store is five members over an opaque key, and a store that records every write is an ordinary substitution rather than an instrumentation hook. The tape under the form above is exactly that, in 148 lines.",
    "/contract/",
    true,
  ],
];

const TRY = [
  ["Change billing", "the message appears on shipping"],
  ["Type in name", "only that row's counter moves"],
];
---

<Base
  title="waypoint — a field's address exists before the component does"
  description="A field's address is a compile-checked type before the leaf that draws it exists, and the cell it names is already written. One registry declaration, no props, no generic arguments, and no register or unregister at mount."
  bare
>
  <!-- No eyebrow. The name is already in the header, two centimetres above. -->
  <h1 class="text-4xl font-bold leading-tight text-balance sm:text-5xl">
    A field's address exists before the component that draws it.
  </h1>
  <p class="lead">
    One claim, two halves. It is a <strong class="text-on-surface">type the
    compiler has already checked</strong> — one registry declaration, no prop,
    no generic argument, nothing imported at the leaf — and it is{" "}
    <strong class="text-on-surface">state already written</strong>: every cell
    is seeded at <code>createForm</code>, so mounting is a subscription and
    there is no register, no unregister and no <code>shouldUnregister</code>.
  </p>

  <div class="mt-7 flex flex-wrap gap-3">
    <a
      class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-on-primary"
      href="/runtime/">See how it behaves →</a
    >
    <a
      class="rounded-xl border border-outline-variant px-5 py-2.5 text-sm font-medium"
      href="https://github.com/maroonedog/waypoint">GitHub</a
    >
  </div>

  <!-- ================================================== the thesis -->
  <section class="mt-16">
    <h2 class="text-2xl font-bold">A field is a string, and the string is checked</h2>
    <p class="lead">
      react-hook-form and TanStack Form reject a typo too — while the form's
      type is in scope. Here it is in scope once, for the whole application: a
      leaf with no props, no form object and no import still rejects{" "}
      <code>shipments[0].lines[0].skuu</code>.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full">
        <thead class="text-left">
          <tr>
            <th class="pr-4">Compiled, TypeScript 5.9 strict</th>
            {LIBS.map((lib) => <th class="pr-4">{lib}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            PATHS.map(([theCase, cells]) => (
              <tr class="hairline">
                <td class="py-2.5 pr-4 align-top font-medium">{theCase}</td>
                {cells.map((cell) => (
                  <td
                    class:list={[
                      "py-2.5 pr-4 align-top",
                      cell.startsWith("compile error") || cell.startsWith("checked")
                        ? "text-primary"
                        : "text-on-surface-variant",
                    ]}
                  >
                    {cell}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="caption">
      One shared schema — <code>shipments[*].lines[*].sku</code> — compiled in
      all four. An interpolated <code>{"${i}"}</code> is not a differentiator:
      it is a real member of react-hook-form's and TanStack's path unions too.
    </p>

    <p class="note">
      <strong>What it costs.</strong> One <code>declare module "@maroonedog/waypoint/react"</code>{" "}
      block that has to stay inside <code>tsconfig</code>'s <code>include</code> —
      delete it and every call site stops compiling, which is the failure
      direction you want. Two limits with it: register a second form and a
      keyless <code>useField</code> is checked against the union of both until
      you name the form key; and{" "}
      <strong class="text-on-surface">seven path segments are addressable and
      eight are not</strong>, so a correct leaf deeper than that is rejected
      rather than accepted. What the union costs the compiler, where it stops,
      and the escape hatch for a subtree you do not address are measured in{" "}
      <a
        class="text-primary underline underline-offset-4"
        href="https://github.com/maroonedog/waypoint/blob/master/docs/measurements-types.md"
        >docs/measurements-types.md</a
      >.
    </p>

    <p class="mt-8 leading-relaxed text-on-surface-variant">
      <strong class="text-on-surface">The other half is that the cell the
      address names is already written.</strong> Every cell is seeded at{" "}
      <code>createForm</code> from the descriptor list, before any component
      mounts, so a leaf appearing is a subscription and nothing else — no
      register, no unregister, no <code>shouldUnregister</code>, no ref
      callback, and a field in a portal, in a lazy chunk or behind a condition
      is not a case. An address checked at compile time that named nothing until
      a component mounted would only be half an address, which is why these two
      are one claim rather than two features.
    </p>
  </section>

  <!-- ================================================== proof -->
  <section class="mt-16">
    <h2 class="text-2xl font-bold">Five things, each beside itself running</h2>

    <Proof claim={m("a-field").claim} watch={m("a-field").watch} source={aFieldSource} file="AField.tsx">
      <AField client:visible />
    </Proof>

    <Proof claim={m("cross-field").claim} watch={m("cross-field").watch} source={crossFieldSource} file="CrossField.tsx">
      <CrossField client:visible />
    </Proof>

    <Proof claim={m("a-list").claim} watch={m("a-list").watch} source={aListSource} file="AList.tsx">
      <AList client:visible />
    </Proof>

    <Proof claim={m("uncontrolled").claim} watch={m("uncontrolled").watch} source={uncontrolledSource} file="Uncontrolled.tsx">
      <Uncontrolled client:visible />
    </Proof>

    <Proof claim={m("switch-a-step-off").claim} watch={m("switch-a-step-off").watch} source={switchAStepOffSource} file="SwitchAStepOff.tsx">
      <SwitchAStepOff client:visible />
    </Proof>
  </section>

  <!-- ================================================== live -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">The runtime, with its writes printed</h2>
    <p class="caption">
      A rule reporting onto a field nobody touched is not scarce — every
      whole-record validator does it. What differs is the bill. At 201 fields
      this costs one pass over 201 paths and 2 commits; the react-hook-form{" "}
      <code>deps</code> configuration costs two passes over 402 paths; and{" "}
      <code>react-hook-form-scoped</code> costs 0 commits by showing no message
      at all, which the benchmark scores <em>disagrees</em> rather than a win.
    </p>

    <LiveForm client:load />

    <ul class="mt-5 grid gap-2 sm:grid-cols-2">
      {
        TRY.map(([what, then]) => (
          <li class="flex gap-2 text-sm leading-relaxed">
            <span class="font-medium whitespace-nowrap">{what}</span>
            <span class="text-on-surface-variant">— {then}</span>
          </li>
        ))
      }
    </ul>

    <p class="caption">
      The real library, built from source. The panel at the bottom is the cell
      store narrating itself — a recording store passed to{" "}
      <code>createForm</code>, which is the ordinary way to substitute one.
    </p>
  </section>

  <!-- ================================================== the whole idea -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">All of that, in ten lines</h2>
    <Code code={whole} label="the whole idea" />
  </section>

  <!-- ================================================== what you can build -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">What you can build with it</h2>
    <p class="caption">
      The struck-through rows are things it does not do, and each says what to
      reach for instead. They are in the table because leaving them out is how
      a table like this becomes an advertisement.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full">
        <thead class="text-left">
          <tr>
            <th class="pr-4">What you need</th>
            <th class="pr-4">How</th>
            <th>&nbsp;</th>
          </tr>
        </thead>
        <tbody>
          {
            CAN.map(([need, how, where, no]) => (
              <tr class="hairline">
                <td
                  class:list={[
                    "py-2.5 pr-4 align-top",
                    no ? "text-on-surface-variant line-through decoration-error/60" : "font-medium",
                  ]}
                >
                  {need}
                </td>
                <td class="py-2.5 pr-4 align-top text-on-surface-variant">
                  {how}
                </td>
                <td class="py-2.5 align-top whitespace-nowrap">
                  {where === "" ? (
                    ""
                  ) : (
                    <a
                      class="text-primary underline underline-offset-4"
                      href={where}
                    >
                      →
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- ================================================== in code -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">Six things, in code</h2>
    <!-- min-w-0 on the item: a grid item defaults to min-width:auto, so the
         widest code block sizes the track and the page scrolls sideways on a
         phone. Same trap as the API entries. -->
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      {
        snippets.map((one) => (
          <div class="min-w-0">
            <p class="mb-2 text-sm font-semibold">{one.title}</p>
            <Code code={one.code} lang={one.lang} flush />
            {one.note && (
              <p class="caption">{one.note}</p>
            )}
          </div>
        ))
      }
    </div>
    <p class="caption">
      Every hook and component, with its real signature, is on{" "}
      <a class="text-primary underline underline-offset-4" href="/api/">API</a>.
    </p>
  </section>

  <!-- ================================================== measured -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">Measured, losses first</h2>
    <p class="caption">
      <strong class="text-on-surface">waypoint is behind on all three
      scenarios, at every size</strong> — the report says so in those words
      before it prints a table.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-on-surface-variant">
          <tr class="hairline">
            <th class="py-2 pr-4 font-medium">at 201 fields</th>
            <th class="py-2 pr-4 font-medium">waypoint</th>
            <th class="py-2 pr-4 font-medium">beaten by</th>
            <th class="py-2 font-medium">which was scored</th>
          </tr>
        </thead>
        <tbody>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">type a character, verdict unchanged</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">212 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — waypoint (uncontrolled)</td
            >
            <td class="py-3 align-top text-on-surface-variant">agrees</td>
          </tr>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">the typed field becomes wrong</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">424 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — react-hook-form-on-submit</td
            >
            <td class="py-3 align-top text-on-surface-variant"
              >agrees at submit only</td
            >
          </tr>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">a rule reports elsewhere</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">424 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — react-hook-form-scoped</td
            >
            <td class="py-3 align-top font-medium text-error">disagrees</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="caption">
      Every integer here is gated: CI fails when one of them moves.{" "}
      <a class="text-primary underline underline-offset-4" href="/benchmark/"
        >What the benchmark can and cannot see →</a
      >
    </p>
  </section>

  <!-- ================================================== status -->
  <section class="mt-20 rounded-xl border border-outline-variant p-6">
    <p class="label">Where it stands</p>
    <p class="mt-3 leading-relaxed">
      <strong>Nothing has ever been published — the publish workflow is
      manual-dispatch only and has never been run — and nobody has run it in
      production.</strong>
    </p>
    <p class="caption">
      277 tests, the eight compile-time programs <code>test:types</code> runs,
      and a screen that uses all of it. Two limits: a field whose key contains a
      dot cannot be addressed, and the validation pass judges the whole root on
      every settled change.
    </p>
  </section>
</Base>
