---
// ===========================================================================
// index.astro — code first, prose second.
//
// A reader deciding whether to use this wants to see what it looks like to
// write and what it does when they type in it. Both are on the page before
// any argument is made, and the arguments that remain are one sentence each.
// ===========================================================================
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import LiveForm from "../demo/LiveForm.tsx";

const whole = `
// 1. Any validator becomes a form description. One function, named by you.
const orderAdapter = zodFormResolver(orderSchema);

// 2. Its types, registered once for the whole application.
declare module "form-react" {
  interface FormTypeRegistry { form: typeof orderAdapter }
}

// 3. Any component, any depth. No props, no context type, no assertions.
const field = useField("billing.postcode");   //  string | undefined
const typo  = useField("billing.postcod");    //  compile error
`;

const snippets = [
  {
    title: "A field",
    note: "It subscribes to the cells it reads and to nothing else.",
    lang: "tsx" as const,
    code: `const field = useField("owner.name");

<input {...field.inputProps} />
<em>{field.issues[0]?.message}</em>`,
  },
  {
    title: "A list",
    note: "There is no nested-array API.",
    lang: "tsx" as const,
    code: `const items = useRows("items");

items.rows.map((row) => (
  <Sku key={row.key} at={\`\${row.path}.sku\`} />
))
items.insert(items.rows.length, { sku: "" });`,
  },
  {
    title: "A cross-field rule",
    note: "No deps array, no dependents list.",
    lang: "ts" as const,
    code: `.superRefine((value, ctx) => {
  if (value.billing.postcode !== value.shipping.postcode) {
    ctx.addIssue({
      path: ["shipping", "postcode"],   // not the field being typed in
      message: "Does not match billing",
    });
  }
})`,
  },
  {
    title: "Submit",
    note: "",
    lang: "ts" as const,
    code: `const { submitted, blockedBy } = await form.submit(save);

// blockedBy carries every blocking issue, including
// paths with no component on screen.`,
  },
  {
    title: "Not waking React",
    note: "The same cell, subscribed imperatively. A keystroke costs 0 commits.",
    lang: "tsx" as const,
    code: `const field = useUncontrolledField("owner.name");

<input defaultValue={field.defaultValue} ref={field.ref}
       onChange={field.onChange} onBlur={field.onBlur} />`,
  },
  {
    title: "Switching a subtree off",
    note: "It stops blocking submit and keeps its values.",
    lang: "ts" as const,
    code: `useParticipation(form, "shipping", !sameAsBilling);

// A rule comparing against it goes on reading it.`,
  },
];

const TRY = [
  ["Change billing", "the message appears on shipping"],
  ["Type in name", "only that row's counter moves"],
];
---

<Base
  title="form-contract — one function turns a validator into a form"
  description="A contract that lets any validator describe itself as a form, and a React runtime that updates only the fields that moved. Type into the live form on the page and watch the render counters."
  bare
>
  <p class="text-sm font-medium tracking-wide text-primary">form-contract</p>
  <h1 class="mt-3 text-4xl font-bold leading-tight text-balance sm:text-5xl">
    One function turns a validator into a form.
  </h1>
  <p class="lead">
    A renderer needs to know what a field accepts <em>before</em> anyone types
    in it. Validation answers after a value exists — too late to choose an
    input or fill in <code>minlength</code>. This is the other half.
  </p>

  <div class="mt-7 flex flex-wrap gap-3">
    <a
      class="rounded-xl bg-primary px-5 py-2.5 text-sm font-medium text-on-primary"
      href="/runtime/">See how it behaves →</a
    >
    <a
      class="rounded-xl border border-outline-variant px-5 py-2.5 text-sm font-medium"
      href="https://github.com/maroonedog/form-contract">GitHub</a
    >
  </div>

  <Code code={whole} />

  <!-- ================================================== live -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">The error belongs to the field you did not touch</h2>

    <LiveForm client:load />

    <ul class="mt-5 grid gap-2 sm:grid-cols-2">
      {
        TRY.map(([what, then]) => (
          <li class="flex gap-2 text-sm leading-relaxed">
            <span class="font-medium whitespace-nowrap">{what}</span>
            <span class="text-on-surface-variant">— {then}</span>
          </li>
        ))
      }
    </ul>

    <p class="caption">
      The real library, built from source.
    </p>
  </section>

  <!-- ================================================== in code -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">Six things, in code</h2>
    <!-- min-w-0 on the item: a grid item defaults to min-width:auto, so the
         widest code block sizes the track and the page scrolls sideways on a
         phone. Same trap as the API entries. -->
    <div class="mt-6 grid gap-6 lg:grid-cols-2">
      {
        snippets.map((one) => (
          <div class="min-w-0">
            <p class="mb-2 text-sm font-semibold">{one.title}</p>
            <Code code={one.code} lang={one.lang} flush />
            {one.note && (
              <p class="caption">{one.note}</p>
            )}
          </div>
        ))
      }
    </div>
    <p class="caption">
      Every hook and component, with its real signature, is on{" "}
      <a class="text-primary underline underline-offset-4" href="/api/">API</a>.
    </p>
  </section>

  <!-- ================================================== measured -->
  <section class="mt-20">
    <h2 class="text-2xl font-bold">Measured, losses first</h2>
    <p class="caption">
      <strong class="text-on-surface">form-contract is behind on all three
      scenarios, at every size</strong> — the report says so in those words
      before it prints a table.
    </p>

    <div class="mt-6 overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-left text-on-surface-variant">
          <tr class="hairline">
            <th class="py-2 pr-4 font-medium">at 201 fields</th>
            <th class="py-2 pr-4 font-medium">form-contract</th>
            <th class="py-2 pr-4 font-medium">beaten by</th>
            <th class="py-2 font-medium">which was scored</th>
          </tr>
        </thead>
        <tbody>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">type a character, verdict unchanged</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">212 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — form-contract-uncontrolled</td
            >
            <td class="py-3 align-top text-on-surface-variant">agrees</td>
          </tr>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">the typed field becomes wrong</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">424 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — react-hook-form-on-submit</td
            >
            <td class="py-3 align-top text-on-surface-variant"
              >agrees at submit only</td
            >
          </tr>
          <tr class="hairline">
            <td class="py-3 pr-4 align-top">a rule reports elsewhere</td>
            <td class="py-3 pr-4 align-top font-mono text-xs tabular-nums">424 fibers</td>
            <td class="py-3 pr-4 align-top font-mono text-xs"
              >0 — react-hook-form-scoped</td
            >
            <td class="py-3 align-top font-medium text-error">disagrees</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="caption">
      Every integer here is gated: CI fails when one of them moves.{" "}
      <a class="text-primary underline underline-offset-4" href="/benchmark/"
        >What the benchmark can and cannot see →</a
      >
    </p>
  </section>

  <!-- ================================================== status -->
  <section class="mt-20 rounded-xl border border-outline-variant p-6">
    <h2 class="text-lg font-bold">Where it stands</h2>
    <p class="mt-3 leading-relaxed">
      <strong>No package has ever been published — there is no publish script
      and no publish workflow — and nobody has run it in production.</strong>
    </p>
    <p class="caption">
      128 tests, six compile-time programs that pin the path types, and a
      screen that uses all of it. Two limits: a field whose key contains a dot
      cannot be addressed, and the validation pass judges the whole root on
      every settled change.
    </p>
  </section>
</Base>
