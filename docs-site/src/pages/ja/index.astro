// 表だけを眺めて先へ行く読者に間違った形が残ります。差は6つではなく1つです。
interface PathRow {
  readonly theCase: string;
  readonly cells: readonly string[];
  /** waypoint・react-hook-form・TanStack Form が同じ結果を出す行。 */
  readonly same?: true;
}

