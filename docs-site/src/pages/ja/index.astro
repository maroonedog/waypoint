// ===========================================================================
// ja/index.astro — / の日本語版。
//
// 原文は ../index.astro で、食い違ったときは英語が正です。
//
// TRANSLATED, NOT TRANSPOSED. 一文ずつ対応させるのではなく、同じことを日本語で
// 言い直しています。文の切り方が変わっている箇所はありますが、主張・数値・
// コード・ライブラリ名・ファイルパスは一つも変えていません。
//
// コードは ../../demo/landing-code.ts から来ます。英語版と同じモジュールなので、
// 訳文の側でコードが古くなることは構造的に起こりません。translate できるのは
// 文であって、署名ではない。
//
// 埋め込まれている5つのデモと下のフォームは、動いているプログラムそのものです。
// その中のラベルや文言は英語のまま ― プログラムを訳すとそれはもう
// 「このサイトが動かしているプログラム」ではなくなるからで、ページにもそう
// 書いてあります。
// ===========================================================================
import Base from "../../layouts/Base.astro";
import Code from "../../components/Code.astro";
