---
// ===========================================================================
// [page].astro — 日本語版がまだ無いページ。
//
// ONE FILE FOR EIGHT ROUTES, and it exists so that the language control never
// lands a reader somewhere that does not exist and never hands them English
// without saying so. Astro's own `fallback` would have served the English page
// under a Japanese URL silently; astro.config.mjs does not set it, and this
// stands in its place.
//
// The list and the summaries are in ../../i18n/untranslated.ts, because
// `getStaticPaths` is hoisted out of this frontmatter and cannot see a value
// declared beside it.
// ===========================================================================
import Base from "../../layouts/Base.astro";
import { UNTRANSLATED, type Untranslated } from "../../i18n/untranslated.js";

export function getStaticPaths() {
  return UNTRANSLATED.map((one) => ({ params: { page: one.slug }, props: one }));
}

const { route, title, about } = Astro.props as Untranslated;
---

<Base
  title={`${title} — waypoint`}
  description={`${title}のページは英語だけです。何が書いてあるかの要約と、原文への案内。`}
>
  <h1>{title}</h1>

  <p class="lead">
    このページはまだ日本語になっていません。<strong>原文は英語版のほうです。</strong>
  </p>

  {about.map((line) => <p>{line}</p>)}

  <p class="note">
    <strong>読むなら英語版へどうぞ。</strong>{" "}
    <a class="link" href={route} hreflang="en" lang="en">{title}（英語）→</a>
  </p>

  <p class="caption">
    日本語になっているのは<a class="link" href="/ja/">概要</a>と<a
      class="link"
      href="/ja/start/">はじめる</a
    >の2ページです。使うかどうかを決めるのに要るのがこの2つで、ほかは決めたあとに引くページなので、この順にしています。
    このサイトの共通語は英語で、日本語はその上の層。食い違っていたら英語が正です。
  </p>
</Base>
