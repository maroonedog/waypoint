---
// ===========================================================================
// api.astro — everything you can call, with its real signature.
//
// The signatures are copied from the package's emitted .d.ts rather than
// written from memory, because a reference that is approximately right is
// worse than none: a reader trusts it and stops reading the types.
// ===========================================================================
import { servedPath } from "../i18n/locales.mjs";
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import ApiEntry from "../components/ApiEntry.astro";

const entryPoints = [
  ["@maroonedog/waypoint/resolver-valibot", "valibotFormResolver", "Valibot descriptors and typed issue codes."],
  ["@maroonedog/waypoint/react", "useField · useRows · useFormStatus · FormProvider · <Field>", "What a screen imports."],
  ["@maroonedog/waypoint/vue", "useField · useRows · useFormStatus · FormProvider · <Field>", "The same, for Vue 3, against the same registry."],
  ["@maroonedog/waypoint", "FormAdapter · FormIssue · FormPathTo · FormPathOver", "The contract and the path types. No dependencies."],
  ["@maroonedog/waypoint/resolver-standard", "standardFormResolver", "Any validator that speaks Standard Schema and its JSON Schema companion. Names no vendor."],
  ["@maroonedog/waypoint/resolver-zod", "zodFormResolver", "The above, plus the three facts zod's JSON Schema does not carry about zod."],
  ["@maroonedog/waypoint/resolver-luq", "luqFormResolver", "The above, plus luq's issue codes, which the spec has no member for."],
  ["@maroonedog/waypoint/core", "createForm · createCellStore · assertFormStoreContract", "The runtime. No React."],
  ["@maroonedog/waypoint/store-zustand", "createZustandCellStore", "A worked example of substituting the store."],
];

const hooks = [
  {
    name: "useCreateForm()",
    summary:
      "Creates a form once per component lifetime. Supply its options through a function.",
    signature: `function useCreateForm<T, TPath extends string>(
  options: () => FormOptions<T, TPath>
): FormHandle<T, TPath>`,
    example: `const form = useCreateForm(() => ({
  adapter: orderAdapter,
  defaultValues,
  validateOn: "blur",         // "change" (the default) | "blur" | "submit"
  onFieldMismatch: "throw",   // "warn" (the default) | "throw" | "ignore"
}));

<FormProvider form={form}>…</FormProvider>`,
  },
  {
    name: "useField()",
    summary:
      "Reads and updates one concrete field. Wildcard paths require useFieldValues.",
    signature: `function useField<Q extends FormPath>(
  path: Q & InhabitedFormPath<Q>,
  options?: {
    showIssues?: "immediately" | "touched" | "dirty";
    messageFor?: FormMessageFor<CodesAtFormPath<Q>>;
  }
): FieldBinding<ValueAtFormPath<Q>>`,
    example: `const field = useField("form:owner.name");

<label {...field.labelProps}>Name</label>
<input {...field.inputProps} />
<em {...field.errorProps}>{field.issues[0]?.message}</em>`,
    returns: [
      { name: "value", type: "T | undefined", note: "The current value." },
      { name: "issues", type: "readonly FormIssue[]", note: "Issues visible under showIssues; always an array. Hidden issues can still block submission." },
      { name: "isTouched", type: "boolean", note: "Set by markTouched, usually on blur." },
      { name: "isDirty", type: "boolean", note: "Differs from the value it was built with." },
      { name: "isParticipating", type: "boolean", note: "Whether it counts toward blocking a submit." },
      { name: "setValue", type: "(next) => void", note: "Writes, then asks for one coalesced pass — under validateOn \"change\", once a submit has been refused, or when this path or one above it is already carrying an issue, so a complaint never outlives the value it was about." },
      { name: "markTouched", type: "() => void", note: "Display state, and the blur moment: it asks for a pass under validateOn \"blur\" and for none otherwise." },
      { name: "setParticipating", type: "(on) => void", note: "Keeps the value either way." },
      { name: "validate", type: "() => MaybeAsync<FormIssue[]>", note: "The form's own pass, filtered to this path." },
      { name: "issuesFor", type: "(candidate) => MaybeAsync<FormIssue[]>", note: "What a value WOULD produce. Writes nothing." },
      { name: "inputProps", type: "FieldInputProps", note: "id / name / required / type, value or checked (and neither, for a file — the one input React cannot control), onChange / onBlur, the declared bounds, and aria-invalid and aria-describedby when they apply." },
      { name: "labelProps", type: "FieldLabelProps", note: "htmlFor, pointing at the same id inputProps carries." },
      { name: "descriptionProps", type: "FieldDescriptionProps | undefined", note: "An id for the help line. Undefined when the schema declared no description, so nothing points at an element you do not draw." },
      { name: "errorProps", type: "FieldErrorProps", note: "An id and role=\"alert\". A live region announces reliably only if the element was already in the document, so render it always and let it be empty." },
      { name: "decorate", type: "(element, part?) => ReactElement", note: "Your own element with this field's props merged in. Handlers and refs compose, aria-describedby joins, the field wins on every key it sets, everything else is untouched — the two a spread loses silently. part defaults to \"input\"." },
      { name: "path", type: "string", note: "The concrete path, as resolved." },
      { name: "descriptor", type: "FormFieldDescriptor | undefined", note: "What the validator declared here." },
    ],
    returnsTitle: "FieldBinding<T>",
  },
  {
    name: "useUncontrolledField()",
    summary:
      "The same field, subscribed imperatively: the listener writes the DOM node instead of re-rendering, so typing reaches React not at all. It cannot transform a value as it is typed — masking and formatting need useField.",
    signature: `function useUncontrolledField<Q extends FormPath>(
  path: Q & InhabitedFormPath<Q>,
  options?: {
    showIssues?: "immediately" | "touched" | "dirty";
    messageFor?: FormMessageFor<CodesAtFormPath<Q>>;
  }
): UncontrolledFieldBinding<ValueAtFormPath<Q>>`,
    example: `const field = useUncontrolledField("form:owner.name");

<input defaultValue={field.defaultValue} ref={field.ref}
       onChange={field.onChange} onBlur={field.onBlur} />`,
    returns: [
      { name: "ref", type: "RefObject<HTMLInputElement>", note: "Put it on the input. The runtime writes the node through it." },
      { name: "defaultValue", type: "string", note: "Read at mount only; React ignores it afterwards, which is intended." },
      { name: "onChange", type: "(event) => void", note: "Takes currentTarget.value." },
      { name: "onBlur", type: "() => void", note: "Marks touched." },
      { name: "issues / isTouched / isParticipating", type: "—", note: "Subscribed. No value and no isDirty: subscribing to those is the cost this hook avoids." },
      { name: "setValue / markTouched / validate / issuesFor", type: "—", note: "As on FieldBinding." },
      { name: "inputProps / labelProps / descriptionProps / errorProps", type: "—", note: "Same attributes as FieldBinding, with ref and defaultValue replacing value." },
      { name: "decorate", type: "(element, part?) => ReactElement", note: "As on FieldBinding, and the ref composes rather than replacing one the caller already put on the element." },
    ],
    returnsTitle: "UncontrolledFieldBinding<T>",
  },
  {
    name: "useFieldValue()",
    summary:
      "Subscribes to one field value without subscribing to its issues.",
    signature: `function useFieldValue<Q extends FormPath>(
  path: Q & InhabitedFormPath<Q>
): ValueAtFormPath<Q> | undefined`,
    example: `const sameAsBilling = useFieldValue("form:sameAsBilling") === true;`,
  },
  {
    name: "useFieldValues()",
    summary:
      "Every place a wildcard covers, read as a column. The one hook here that is not O(1): it subscribes to one cell per place, plus the row order of every array the path crosses. Its path type is the WIDE one — each [*] independently kept or bound — because this is the one hook that addresses a set rather than a value.",
    signature: `function useFieldValues<Q extends FormColumnPath>(
  path: Q & InhabitedFormPath<Q>
): readonly ValueAtFormPath<Q>[]`,
    example: `const skus  = useFieldValues("form:items[*].sku");        // readonly string[]
const inRow = useFieldValues("form:shipments[0].lines[*].sku");  // one row's column`,
  },
  {
    name: "useFieldIssues()",
    summary:
      "One field's issues and nothing else, so typing in an input never re-renders the summary beside it. Not gated by showIssues: that policy lives in the bindings, because it is about whether one input is ready to complain to the person typing in it. A summary reading this reports what is true whatever an input kept to itself, the same way errorCount does. It IS gated by messageFor, which is the same line drawn the other way: wording is per application, so two sentences for one issue on one screen is the defect.",
    signature: `function useFieldIssues<Q extends FormPath>(
  path: Q & InhabitedFormPath<Q>
): readonly FormIssue[]`,
    example: `const listIssues = useFieldIssues("form:items");   // the array-level rule`,
  },
  {
    name: "useRows()",
    summary:
      "The row ORDER of one array, and the three edits that change it. Editing a member of a row leaves the order untouched, so a list does not re-render because somebody typed in it. Concrete, because one list has one order: an inner list is reached through the outer row's own address, `${row.path}.lines`.",
    signature: `function useRows<Q extends FormListPath>(path: Q): RowsBinding<Q>`,
    example: `const items = useRows("form:items");

items.rows.map((row) => <Sku key={row.key} at={\`\${row.path}.sku\`} />)
items.insert(items.rows.length, { sku: "" });
items.remove(0);
items.move(0, 2);`,
    returns: [
      { name: "path", type: "Q", note: "The concrete path this list lives at, qualified." },
      { name: "rows", type: "readonly FieldRow[]", note: "In order. See below." },
      { name: "insert", type: "(at, value?) => void", note: "" },
      { name: "remove", type: "(at) => void", note: "" },
      { name: "move", type: "(from, to) => void", note: "" },
      { name: "row.key", type: "string", note: "Opaque, stable for the row's life. The React key, never an address." },
      { name: "row.index", type: "number", note: "" },
      { name: "row.path", type: "`${Q}[${number}]`", note: "Where the row lives, qualified by its form — so a path built from it is complete and nothing has to be threaded beside it." },
    ],
    returnsTitle: "RowsBinding<Q>",
  },
  {
    name: "useFormStatus()",
    summary: "The four form-level aggregates, each its own cell.",
    signature: `function useFormStatus(formKey?: FormKey): FormStatus`,
    returns: [
      { name: "errorCount", type: "number", note: "Issues that currently block a submit; a dormant subtree is excluded." },
      { name: "isSubmitting", type: "boolean", note: "" },
      { name: "submitCount", type: "number", note: "" },
      { name: "isValidating", type: "boolean", note: "True while any pass is in flight." },
    ],
    returnsTitle: "FormStatus",
  },
  {
    name: "useParticipation()",
    summary:
      "Switches a subtree out of what blocks a submit, and back on unmount. The values stay in the store, so a rule comparing against them goes on reading them. A place, not a rule: a dormant root is matched with a segment-anchored prefix test, so a wildcard root matches nothing and would silence nothing. It is the one path-taking hook given its handle rather than reading one from context, and it takes either spelling of a path — a row is silenced by row.path, which arrives qualified.",
    signature: `function useParticipation<T, TPath extends string>(
  form: FormHandle<T, TPath>,
  path: ConcretePath<TPath> | \`\${FormKey}:\${ConcretePath<TPath>}\`,
  participating: boolean | undefined
): void`,
    example: `useParticipation(form, "form:shipping", !sameAsBilling);`,
  },
  {
    name: "useForm()",
    summary:
      "The enclosing handle. Naming a key checks it against the provider's and throws when they disagree; naming none accepts whichever provider is there.",
    signature: `function useForm(): FormHandle<AnyValues, AnyPath>
function useForm<TKey extends FormKey>(key: TKey): FormHandle<ValuesFor<TKey>, PathsFor<TKey>>`,
    example: `const form = useForm();
await form.submit(save);`,
    returns: [
      { name: "field", type: "(path) => FieldHandle", note: "Outside React too: sources, setValue, validate, issuesFor." },
      { name: "rows", type: "(arrayPath) => RowsHandle", note: "" },
      { name: "submit", type: "(handler) => Promise<SubmitOutcome>", note: "{ submitted, blockedBy }. Judges the whole root and sends that validated snapshot; later edits stay in the form." },
      { name: "adoptIssues", type: "(issues) => void", note: "The setError of this library. Merged into every pass, so they are counted and reported; one submit is refused by them and consumes them." },
      { name: "reset", type: "(defaultValues?) => void", note: "" },
      { name: "validate", type: "(paths?) => MaybeAsync<FormIssue[]>", note: "Judges now. Omit paths for the whole form; concrete paths request partial execution when the adapter supports it. Issues outside the executed scopes are preserved." },
      { name: "readRoot", type: "() => unknown", note: "A root being edited is a draft, so it is not a T." },
      { name: "errorCount / submitting / submitCount / validating", type: "CellSource<…>", note: "Subscribe directly, outside React if you like." },
      { name: "descriptors / tree", type: "—", note: "What the validator declared, flat and as a tree." },
      { name: "store", type: "FormCellStore", note: "The cell space itself." },
    ],
    returnsTitle: "FormHandle<T, TPath>",
  },
  {
    name: "useCell()",
    summary:
      "Any CellSource, subscribed. Every hook above is built from this one call, and so is anything you write yourself.",
    signature: `function useCell<T>(source: CellSource<T>): T`,
    example: `const errors = useCell(form.errorCount);`,
  },
];

const components = [
  {
    name: "<FormProvider>",
    summary:
      "Puts one handle in reach of a subtree. formKey says which registered form this is, and a qualified path below is compared against it; omit it and the key the form was created with is used, so the name is written once. Give both and they must agree — a disagreement throws where it is rendered, because it makes every path beneath read a form nobody meant. Once the subtree has mounted it is also asked whether every declared field reached a component; partial says this screen draws part of the form on purpose and skips that question, leaving the rest.",
    signature: `<FormProvider form={form} formKey?="order" widgets?={registry}
              showIssues?="touched" messageFor?={fn} partial?>`,
  },
  {
    name: "<Field>",
    summary:
      "Layers 2 and 3 in one component: a children function gets the binding, and without one a widget is looked up by name from the registry.",
    signature: `<Field path="form:owner.name">{(field) => …}</Field>
<Field path="form:owner.name" as="postcode" />`,
  },
  {
    name: "<FieldRows>",
    summary:
      "useRows as a component. It renders no wrapper and no button — what a row looks like is not this library's business.",
    signature: `<FieldRows path="form:items">{({ rows, insert, remove }) => …}</FieldRows>`,
  },
  {
    name: "<AutoForm>",
    summary:
      "Layer 1: draws the whole form. It walks the registered fields in declaration order and renders each one through the widget registry — so an application writes a widget per KIND of input rather than a component per field, and a field added to the schema appears, labelled from its title, validated and blocking the submit, with no component edited. It ships no input of its own; an empty registry draws nothing. The price is that its paths are read out of the descriptor tree and bound to row indices at run time, which makes this the one layer where a path is not checked by the compiler. There is one running on the showcase, with all three of its files.",
    signature: `<AutoForm only?={["form:billing"]} renderList?={(binding, rows) => …} />`,
    href: servedPath("/showcase/#autoform"),
    hrefLabel: "See one running",
  },
];

const submitTypes = `
interface SubmitOutcome {
  readonly submitted: boolean;
  /** Empty when the form was handed over. */
  readonly blockedBy: readonly FormIssue[];
}

type SubmitHandler = (root: unknown) => void | Promise<void>;
`;

const pathTypes = `
// A declared path names the RULE: "items[*].sku".
// A value has PLACES:             "items[0].sku", "items[1].sku".
// Which of them a surface takes is decided by what it addresses.

type ConcretePath<P>     // every [*] replaced by an index position
type PartlyBoundPath<P>  // each [*] independently kept or bound
type AddressablePath<P>  // P | ConcretePath<P> — the rule or a place
type DeclaredOf<P>       // the reverse: every [0] back to [*]
type InhabitedPath<T, K> // K, unless T has no value at K

// These are UNQUALIFIED — one form's own vocabulary, which is all the contract
// layer and the runtime ever see. The prefix rides to their LEFT: FormPath is
// ConcretePath with a registered key in front of it, FormColumnPath is
// PartlyBoundPath, FormListPath the arrays, FormDeclaredPath the rules. The
// colon is read by one function in ./react, and nothing below it sees one.
//
// A surface addressing ONE value takes ConcretePath: useField, useFieldValue,
// useFieldIssues, useUncontrolledField, useParticipation, <Field>, and
// useRows / <FieldRows> over one list's order. Each of them reaches a runtime
// that refuses a wildcard, so accepting one only moved the failure later.
//
// useFieldValues takes PartlyBoundPath, which is WIDER than either: it reads a
// column, so "shipments[0].lines[*].sku" — one row's column — is a question it
// can answer and the rule-or-place union could not spell.
//
// ConcretePath<string> is string, which is why a form registered as
// FormAdapter<unknown, string> is back to unchecked paths.
//
// InhabitedPath is intersected into the path parameter, and it is what checks
// the one place a path union cannot: below a Record<string, T> key the union
// widens to \`bag.\${string}\`, which absorbs every path beneath it, so
// ValueAtPath is asked instead — it walks the path and answers never.
`;

const types = `
// The registry. One declaration, anywhere in the compilation.
interface WaypointForms {}

// Every path union below is QUALIFIED: "form:billing.postcode". Name a form as
// the second argument to take that form's paths and no other's.
FormPath                       // every registered PLACE, containers included
FormColumnPath                 // wildcards kept or bound: what useFieldValues takes
FormListPath                   // the lists: what useRows and <FieldRows> take
FormDeclaredPath               // the rules, [*] still standing: what AutoForm.only takes
FormPathTo<string>             // only the paths whose value is a string
FormPathTo<string, "profile">  // and only that form's
FormPathOver<"postcode">       // only the prefixes that have those underneath

FormKey                        // every key the application registered
FormValues<typeof adapter>     // the form's value type
FormPaths<typeof adapter>      // the paths it declares
`;

// The three Types headings carry ids of their own, because the layout's rail
// script mints them for h2 only and these are h3. Each is named for the first
// type it documents, so the index entry and the heading are the same word.
const TYPE_NAMES = ["SubmitOutcome", "ConcretePath", "FormPath"] as const;

// THE INDEX IS GROUPED, AND IT HOLDS EVERY SECTION. Flat, it ran fifteen
// names together at 12px with nothing between the hooks and the components —
// and it left the Types section out entirely, under a heading that says "On
// this page". A reader who scans a list labelled that way and does not find
// `FormPathTo` concludes it is not documented.
const INDEX: readonly (readonly [string, readonly string[]])[] = [
  ["Hooks", hooks.map((one) => one.name)],
  ["Components", components.map((one) => one.name)],
  ["Types", TYPE_NAMES],
];
const slugOf = (name: string): string =>
  name.replace(/[^A-Za-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<Base
  title="API — waypoint"
  description="Every hook, component and path type, with the signature the package itself emits and what each one hands back."
>
  <h1>API</h1>
  <p class="lead">
    Signatures are the ones the package emits. Every path names its form —{" "}
    <code>useField("order:billing.postcode")</code> — and with a single form
    registered the prefix is optional.
  </p>

  <!-- THE NAMES ARE THE INSTRUMENT, so they are set in the reading ink rather
       than the quiet one. This index is not chrome like the section list in the
       left margin — it is the only thing on the page that puts all seventeen
       entry names in one field of view, and a reader who came here for one of
       them is scanning it, not reading past it. The mark is left out of the
       hover on purpose: it means a place with a value in it, and it stops
       meaning that the moment it also means "a link is under the pointer".

       The top margin is kept because nothing in styles.css spaces this element:
       the sheet spaces headings, sections and code blocks, and a `nav` after a
       lead is none of those. It is written as the sheet's own variable so it
       tracks this page's denser register instead of restating a number. -->
  <nav
    class="mt-[var(--gap-block)] grid gap-2"
    aria-label="Everything on this page"
  >
    {
      INDEX.map(([group, names]) => (
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
          <span class="label w-24 shrink-0">{group}</span>
          {names.map((name) => (
            <a
              class="link font-mono text-[0.8125rem]"
              href={`#${slugOf(name)}`}
            >
              {name}
            </a>
          ))}
        </div>
      ))
    }
  </nav>

  <h2 id="imports">Imports</h2>
  <div class="overflow-x-auto"><table><thead><tr><th>Package entry</th><th>Exports</th></tr></thead>
    <tbody>{entryPoints.map(([entry, exports]) => <tr><td><code>{entry}</code></td><td>{exports}</td></tr>)}</tbody>
  </table></div>
  <h2>Hooks</h2>
  <!-- gap-10 against ApiEntry's own `pt-6`: the rule opening an entry sits
       nearer the entry it opens than the one it closes. Changing it here would
       centre every rule between two entries. -->
  <div class="grid gap-10">
    {hooks.map((one) => <ApiEntry {...one} />)}
  </div>

  <h2>Components</h2>
  <div class="grid gap-10">
    {components.map((one) => <ApiEntry {...one} />)}
  </div>

  <h2>Types</h2>

  <h3 id="SubmitOutcome">SubmitOutcome, SubmitHandler</h3>
  <p>
    What <code>form.submit()</code> resolves to, and what it hands your handler.{" "}
    <code>blockedBy</code> carries every blocking issue, including paths with no
    component on screen.
  </p>
  <Code code={submitTypes} />

  <h3 id="ConcretePath">ConcretePath, PartlyBoundPath, DeclaredOf, InhabitedPath</h3>
  <p>
    The types every signature above is written in. A descriptor is keyed by the
    rule and a value lives at a place; which one a surface takes follows from
    whether it addresses one value or a set of them.
  </p>
  <Code code={pathTypes} />

  <h3 id="FormPath">The registry, and the view-layer paths</h3>
  <p>
    <a class="link" href={servedPath("/paths/")}
      >How the registry works →</a
    >
  </p>
  <Code code={types} />
</Base>
